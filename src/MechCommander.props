<?xml version="1.0" encoding="utf-8"?>
<!-- Settings shared by the port's own projects (MCCore, MCRedux, mc_tests). Each imports this after
     Microsoft.Cpp.props. SDL keeps its own vcxproj (copied from OgreBattleCPP, already edited to output into src/build
     and to use the static CRT). -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The machine has user-wide vcpkg integration, and its x64-windows tree holds SDL2: with integration on, SDL2
       gets auto-linked and its SDL_Init shadows SDL3's. Every project must keep this off. -->
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnabled>false</VcpkgEnabled>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(SolutionDir)build\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\intermediate\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <MCLibDir>$(MSBuildThisFileDirectory)lib\</MCLibDir>
    <MCGeneratedDir>$(MSBuildThisFileDirectory)build\generated\</MCGeneratedDir>
    <!-- Where MCGenerateVersionHeader writes MCVersion.h. A project that doesn't reference MCCore (the editor) writes
         its own copy elsewhere, so two projects building in parallel never write the same file. -->
    <MCVersionDir Condition="'$(MCVersionDir)'==''">$(MCGeneratedDir)</MCVersionDir>
  </PropertyGroup>
  <!-- The HLSL compiler: Microsoft's DirectXShaderCompiler release, pinned by version and SHA-256, so every machine
       and CI compile the shaders with the same dxc. MCFetchDxc downloads it into build\tools on first use. To update
       it, change the three values (the hash is the zip's, from the release page or Get-FileHash). -->
  <PropertyGroup>
    <MCDxcVersion>v1.9.2609</MCDxcVersion>
    <MCDxcUrl>https://github.com/microsoft/DirectXShaderCompiler/releases/download/v1.9.2609/dxc_2026_09_29.zip</MCDxcUrl>
    <MCDxcSha256>AD31B1FC8443175D204F77A611FDB3EF2EC42759BDC2F1167368DE24A4A7E7F1</MCDxcSha256>
    <MCDxcDir>$(MSBuildThisFileDirectory)build\tools\dxc-$(MCDxcVersion)\</MCDxcDir>
    <MCDxc>$(MCDxcDir)bin\x64\dxc.exe</MCDxc>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <LanguageStandard_C>stdclatest</LanguageStandard_C>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- /bigobj: some reconstructed files (the ABL library, the logistics screens) are large. /utf-8: sources are UTF-8. -->
      <AdditionalOptions>/bigobj /utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(MCLibDir)SDL-release-3.4.12\include;$(MCLibDir)mimalloc-3.3.1\include;$(MCLibDir)bc7enc_rdo;$(MCLibDir)libdeflate-1.26;$(MCLibDir)dr_flac;$(MCLibDir)dav1d-1.5.4\include;$(MCLibDir)xxHash-0.8.4;$(MCLibDir)HDiffPatch-5.1.3;$(MCLibDir)libsodium-1.0.22\src\libsodium\include;$(MCLibDir)nlohmann-json-3.12.0\single_include;$(MCLibDir)miniz-3.0.2;$(MCLibDir)libdatachannel-0.24.6\include;$(MCLibDir)mbedtls-3.6.7\include;$(MCLibDir)mbedtls-3.6.7\mc;$(MCLibDir)MCCore;$(MCGeneratedDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>stdafx.h</PrecompiledHeaderFile>
      <!-- libdatachannel's headers read RTC_STATIC and its RTC_ENABLE_ flags, and every unit including Mbed TLS's
           reads the game's additions to its configuration (src\lib\mbedtls-3.6.7\mc), so all see one layout. -->
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;RTC_STATIC;RTC_ENABLE_MEDIA=0;RTC_ENABLE_WEBSOCKET=1;MBEDTLS_USER_CONFIG_FILE=&lt;mc_mbedtls_config.h&gt;;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(MCVersionDir);$(MCGeneratedDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Version (personal build): version.json's major.minor.patch and the branch's count of commits as the build, the
       same on every platform ("0.2.1 (518)"; src/mac/version.cmake on the Mac). The updaters (Sparkle, WinSparkle)
       install only a higher build, and the count rises with every commit; nbgv's build (upstream's) counts only the
       commits since version.json's version changed, so it starts over at each version and differs between branches.
       MCCore (which every app references, so it builds first) writes it to build\generated\MCVersion.h; the file is
       only rewritten when it changes, so unchanged builds stay incremental. Without git (a source zip) the build is 0;
       a shallow clone counts short, so it warns. -->
  <Target Name="MCGenerateVersionHeader" BeforeTargets="PrepareForBuild" Condition="'$(MCGenerateVersion)'=='true'">
    <PropertyGroup>
      <_MCRepoDir>$(MSBuildThisFileDirectory)..\</_MCRepoDir>
      <_MCVersionJson Condition="Exists('$(_MCRepoDir)version.json')">$([System.IO.File]::ReadAllText('$(_MCRepoDir)version.json'))</_MCVersionJson>
      <_MCRelease>$([System.Text.RegularExpressions.Regex]::Match('$(_MCVersionJson)', '(?&lt;="version"\s*:\s*")\d+\.\d+\.\d+').Value)</_MCRelease>
      <_MCRelease Condition="'$(_MCRelease)'==''">0.0.0</_MCRelease>
    </PropertyGroup>
    <Exec Command="git rev-list --count HEAD 2&gt;nul" WorkingDirectory="$(_MCRepoDir)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MCBuild" />
      <Output TaskParameter="ExitCode" PropertyName="_MCBuildExitCode" />
    </Exec>
    <Exec Command="git rev-parse --short=8 HEAD 2&gt;nul" WorkingDirectory="$(_MCRepoDir)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" ContinueOnError="true" IgnoreExitCode="true"
          Condition="'$(_MCBuildExitCode)'=='0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MCCommit" />
    </Exec>
    <Exec Command="git rev-parse --is-shallow-repository 2&gt;nul" WorkingDirectory="$(_MCRepoDir)"
          ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true" IgnoreExitCode="true"
          Condition="'$(_MCBuildExitCode)'=='0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MCShallow" />
    </Exec>
    <Warning Text="A shallow clone: the build ($(_MCBuild)) counts only the commits fetched; fetch the whole history."
             Condition="'$(_MCShallow)'=='true'" />
    <Warning Text="Could not count the commits (needs git and a checkout); the build is 0."
             Condition="'$(_MCBuildExitCode)'!='0'" />
    <PropertyGroup Condition="'$(_MCBuildExitCode)'!='0'">
      <_MCBuild>0</_MCBuild>
      <_MCCommit>unknown</_MCCommit>
    </PropertyGroup>
    <PropertyGroup>
      <_MCVersion>$(_MCRelease).$(_MCBuild)</_MCVersion>
    </PropertyGroup>
    <ItemGroup>
      <_MCVersionLine Include="// Generated by MechCommander.props from version.json and the git history. Do not edit." />
      <_MCVersionLine Include="#pragma once" />
      <_MCVersionLine Include="#define MC_VERSION &quot;$(_MCVersion)&quot;" />
      <_MCVersionLine Include="#define MC_VERSION_COMMAS $(_MCVersion.Replace('.', ','))" />
      <_MCVersionLine Include="#define MC_VERSION_SEMVER &quot;$(_MCRelease)+$(_MCBuild)&quot;" />
      <_MCVersionLine Include="#define MC_VERSION_COMMIT &quot;$(_MCCommit)&quot;" />
      <_MCVersionLine Include="// Port-only (personal): the version as the game, its reports and the updaters show it, and the build alone." />
      <_MCVersionLine Include="#define MC_VERSION_SHOWN &quot;$(_MCRelease) ($(_MCBuild))&quot;" />
      <_MCVersionLine Include="#define MC_VERSION_BUILD $(_MCBuild)" />
    </ItemGroup>
    <MakeDir Directories="$(MCVersionDir)" />
    <WriteLinesToFile File="$(MCVersionDir)MCVersion.h" Lines="@(_MCVersionLine)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <Message Importance="high" Text="MechCommander Redux $(_MCRelease) ($(_MCBuild)) ($(_MCCommit))" />
  </Target>

  <!-- Fetches the pinned dxc (see MCDxcVersion) before a project's shaders compile, when it isn't there yet. The zip
       must match MCDxcSha256, or the build stops. -->
  <Target Name="MCFetchDxc" BeforeTargets="CustomBuild" Condition="'@(CustomBuild)'!='' and !Exists('$(MCDxc)')">
    <PropertyGroup>
      <_MCDxcDownloads>$(MSBuildThisFileDirectory)build\tools\downloads\</_MCDxcDownloads>
    </PropertyGroup>
    <Message Importance="high" Text="Downloading dxc $(MCDxcVersion) from $(MCDxcUrl)" />
    <DownloadFile SourceUrl="$(MCDxcUrl)" DestinationFolder="$(_MCDxcDownloads)" Retries="3">
      <Output TaskParameter="DownloadedFile" PropertyName="_MCDxcZip" />
    </DownloadFile>
    <GetFileHash Files="$(_MCDxcZip)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_MCDxcZipHash" />
    </GetFileHash>
    <Delete Files="$(_MCDxcZip)" Condition="'$(_MCDxcZipHash)'!='$(MCDxcSha256)'" />
    <Error Condition="'$(_MCDxcZipHash)'!='$(MCDxcSha256)'"
           Text="dxc $(MCDxcVersion): the download's SHA-256 is $(_MCDxcZipHash), expected $(MCDxcSha256)." />
    <Unzip SourceFiles="$(_MCDxcZip)" DestinationFolder="$(MCDxcDir)" />
    <Delete Files="$(_MCDxcZip)" />
    <Error Condition="!Exists('$(MCDxc)')" Text="dxc $(MCDxcVersion): $(MCDxc) isn't in the zip." />
  </Target>
</Project>
