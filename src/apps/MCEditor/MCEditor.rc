IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New...\tCtrl+N", ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Save...\tCtrl+S", ID_FILE_SAVE
        MENUITEM "Save &As...", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Write Distribution File (DPK)...", ID_FILE_WRITE_DISTRIBUTION_FILE_DPK
        MENUITEM SEPARATOR
        MENUITEM "Save &Map Only", ID_FILE_SAVE_MAP_ONLY
        MENUITEM SEPARATOR
        MENUITEM "E&xit", ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z", ID_UNDO
        MENUITEM "&Redo\tCtrl+Y", ID_REDO
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Tactical Map", ID_VIEW_TACTICAL_MAP
        MENUITEM SEPARATOR
        MENUITEM "Map Features &Palette", ID_VIEW_MAP_FEATURES_PALETTE
        MENUITEM "&Main Toolbar", ID_VIEW_MAIN_TOOLBAR
        MENUITEM "&Standard Toolbar", ID_VIEW_STANDARD_TOOLBAR
        MENUITEM SEPARATOR
        MENUITEM "&Gridlines", ID_VIEW_GRIDLINES
        MENUITEM SEPARATOR
        MENUITEM "Zoom &In\t+", ID_VIEW_ZOOM_IN
        MENUITEM "Zoom &Out\t-", ID_VIEW_ZOOM_OUT
    END
    POPUP "&Mission"
    BEGIN
        MENUITEM "Objectives--Team &1", ID_MISSION_OBJECTIVES_TEAM_1
        MENUITEM "Objectives--Team &2", ID_MISSION_OBJECTIVES_TEAM_2, HELP
        MENUITEM SEPARATOR
        MENUITEM "Descriptio&n", ID_MISSION_DESCRIPTION
        MENUITEM SEPARATOR
        MENUITEM "&Settings--Team 1", ID_MISSION_SETTINGS_TEAM_1
        MENUITEM "Set&tings--Team 2", ID_MISSION_SETTINGS_TEAM_2
        MENUITEM SEPARATOR
        MENUITEM "&Drop Zones--Team 1", ID_MISSION_DROP_ZONES_TEAM_1
        MENUITEM "Drop &Zones--Team 2", ID_MISSION_DROP_ZONES_TEAM_2
        MENUITEM SEPARATOR
        POPUP "Time of Da&y"
        BEGIN
            MENUITEM "&Day", ID_MISSION_TIME_OF_DAY_DAY
            MENUITEM "D&usk", ID_MISSION_TIME_OF_DAY_DUSK
            MENUITEM "&Night", ID_MISSION_TIME_OF_DAY_NIGHT
        END
        POPUP "&Weather"
        BEGIN
            MENUITEM "&Clear", ID_MISSION_WEATHER_CLEAR
            MENUITEM "&Rain", ID_MISSION_WEATHER_RAIN
            MENUITEM "&Downpour", ID_MISSION_WEATHER_DOWNPOUR
            MENUITEM "&Light Snow", ID_MISSION_WEATHER_LIGHT_SNOW
            MENUITEM "&Snow", ID_MISSION_WEATHER_SNOW
            MENUITEM "&Blizzard", ID_MISSION_WEATHER_BLIZZARD
        END
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Select", ID_TOOLS_SELECT
        MENUITEM "Select &Area", ID_TOOLS_SELECT_AREA
        MENUITEM "Dra&g View\tSpacebar", ID_TOOLS_DRAG_VIEW
        MENUITEM "Zoom &In\t+", ID_TOOLS_ZOOM_IN
        MENUITEM "&Zoom Out\t-", ID_TOOLS_ZOOM_OUT
        MENUITEM "Spray &Trees\tT", ID_TOOLS_SPRAY_TREES
        MENUITEM "&Erase\tE", ID_TOOLS_ERASE
        MENUITEM "R&otate\tLeft Arrow", ID_TOOLS_ROTATE
        MENUITEM "Raise &Vertex\tUp Arrow", ID_TOOLS_RAISE_VERTEX
        MENUITEM "Lo&wer Vertex\tDown Arrow", ID_TOOLS_LOWER_VERTEX
        MENUITEM "Make &Hilly\tH", ID_TOOLS_MAKE_HILLY
        MENUITEM "&Flatten\tF", ID_TOOLS_FLATTEN
        MENUITEM "&Link Buildings\tL", ID_TOOLS_LINK_BUILDINGS
        MENUITEM "&Unlink Buildings\tU", ID_TOOLS_UNLINK_BUILDINGS
        MENUITEM "&Damage\tD", ID_TOOLS_DAMAGE
        MENUITEM "&Repair\tR", ID_TOOLS_REPAIR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help Topics", ID_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About Mission Editor", ID_APP_ABOUT
    END
END

