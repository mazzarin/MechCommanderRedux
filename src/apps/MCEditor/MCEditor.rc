///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Version
//

// The game's version (MCVersion.h, written by MechCommander.props from version.json and the git history), as
// MCRedux.rc has it. The original's block said 1.99.04.08 / "MCEditor MFC Application".
#include "MCVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MC_VERSION_COMMAS
 PRODUCTVERSION MC_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Unofficial recreation of the MechCommander Gold Mission Editor. Commit " MC_VERSION_COMMIT
            VALUE "FileDescription", "MechCommander Redux Mission Editor"
            VALUE "FileVersion", MC_VERSION
            VALUE "InternalName", "MCEditor"
            VALUE "OriginalFilename", "MCEditor.exe"
            VALUE "ProductName", "MechCommander Redux"
            VALUE "ProductVersion", MC_VERSION_SEMVER
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

