  <!-- SQLite (src\lib\sqlite-3.50.4, the public-domain amalgamation) compiles as one C unit. It lives outside the
       editor, so it has its own ItemGroup, which sync_projects.py leaves alone. -->
  <ItemGroup>
    <ClCompile Include="$(MCLibDir)sqlite-3.50.4\sqlite3.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
      <WarningLevel>Level1</WarningLevel>
      <PreprocessorDefinitions>SQLITE_THREADSAFE=1;SQLITE_OMIT_LOAD_EXTENSION;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>
  <!-- miniz (src\lib\miniz-3.0.2, MIT): its inflate unpacks the Gold CD's editor setup (InstallShieldCabinet). One C
       unit outside the editor, so its own ItemGroup too. -->
  <ItemGroup>
    <ClCompile Include="$(MCLibDir)miniz-3.0.2\miniz.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
      <WarningLevel>Level1</WarningLevel>
      <PreprocessorDefinitions>MINIZ_NO_ARCHIVE_APIS;MINIZ_NO_TIME;MINIZ_NO_STDIO;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>
  <!-- The game's crash trace (a symbolized stack and a minidump beside the exe on a crash, never a dialog), shared from
       src\apps\MCRedux; outside the editor, so in its own ItemGroup too. -->
  <ItemGroup>
    <ClCompile Include="..\MCRedux\MCConsole.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\MCRedux\MCCrashTrace.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(MCLibDir)MCCore;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <ClInclude Include="..\MCRedux\MCConsole.h" />
    <ClInclude Include="..\MCRedux\MCCrashTrace.h" />
  </ItemGroup>
