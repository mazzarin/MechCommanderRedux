// MCRedux.exe's resources: the icon and the version (Explorer's file properties). The version comes from MCVersion.h,
// which MCCore's build writes from version.json and the git history (see MechCommander.props).

#include <winres.h>
#include "MCVersion.h"

// The exe's icon. It must stay the first icon resource: SDL gives its window class the exe's first icon, so this is
// also the window's title bar and taskbar icon.
1 ICON "..\\..\\res\\MCRedux.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MC_VERSION_COMMAS
PRODUCTVERSION MC_VERSION_COMMAS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Unofficial recreation of MechCommander Gold. Commit " MC_VERSION_COMMIT
            VALUE "FileDescription", "MechCommander Redux"
            VALUE "FileVersion", MC_VERSION
            VALUE "InternalName", "MCRedux"
            VALUE "OriginalFilename", "MCRedux.exe"
            VALUE "ProductName", "MechCommander Redux"
            VALUE "ProductVersion", MC_VERSION_SHOWN
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
