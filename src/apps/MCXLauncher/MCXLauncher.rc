// MCX.EXE's resources (the launcher, port-only): Redux's icon, so the original's shortcuts show it, and the launcher's
// own version, not the game's. The launcher is built once and shipped unchanged from release to release
// (src/installer/windows/launcher), so its bytes, and the trust antivirus programs come to give them, stay the same.

#include <winres.h>

1 ICON "..\\..\\res\\MCRedux.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Starts MechCommander Redux HD in the original's place."
            VALUE "FileDescription", "MechCommander Redux HD launcher"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "MCX"
            VALUE "OriginalFilename", "MCX.EXE"
            VALUE "ProductName", "MechCommander Redux HD"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
