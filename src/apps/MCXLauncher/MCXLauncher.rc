// MCX.EXE's resources (the launcher, port-only): Redux's icon, so the original's shortcuts show it, and the version,
// the game's (MechCommander.props writes MCVersion.h into the launcher's intermediate folder).

#include <winres.h>
#include "MCVersion.h"

1 ICON "..\\..\\res\\MCRedux.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MC_VERSION_COMMAS
PRODUCTVERSION MC_VERSION_COMMAS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Starts MechCommander Redux HD in the original's place. Commit " MC_VERSION_COMMIT
            VALUE "FileDescription", "MechCommander Redux HD launcher"
            VALUE "FileVersion", MC_VERSION
            VALUE "InternalName", "MCX"
            VALUE "OriginalFilename", "MCX.EXE"
            VALUE "ProductName", "MechCommander Redux HD"
            VALUE "ProductVersion", MC_VERSION_SHOWN
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
