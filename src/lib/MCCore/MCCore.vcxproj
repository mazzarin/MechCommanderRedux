  <!-- dav1d's x86-64 assembly: the files its meson build assembles for 8 bits a sample, with the shared ones (its
       README.md). Only where NASM runs: MCNasm, the program by its path (the Windows workflow sets it, as an environment
       variable, to the 2.16.03 it fetches and checks, the version dav1d's 1.5 series was tested with), else nasm on
       PATH. MCDav1dX86Asm then makes each a custom build step, NASM run as meson runs it (-f win64, dav1d's src folder
       and config.asm's searched for includes), its object archived into MCCore.lib, and builds dav1d's C files with
       MC_DAV1D_X86_ASM, which turns HAVE_ASM on in its config.h. Without NASM dav1d is its C code alone. -->
  <ItemGroup>
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\cdef_avx2.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\cdef_avx512.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\cdef_sse.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\cpuid.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\filmgrain_avx2.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\filmgrain_avx512.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\filmgrain_sse.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\ipred_avx2.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\ipred_avx512.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\ipred_sse.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\itx_avx2.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\itx_avx512.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\itx_sse.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\loopfilter_avx2.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\loopfilter_avx512.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\loopfilter_sse.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\looprestoration_avx2.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\looprestoration_avx512.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\looprestoration_sse.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\mc_avx2.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\mc_avx512.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\mc_sse.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\msac.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\pal.asm" />
    <MCDav1dAsm Include="$(MCLibDir)dav1d-1.5.4\src\x86\refmvs.asm" />
  </ItemGroup>
  <PropertyGroup>
    <MCDav1dAsmDir>$(IntDir)dav1d\x86\</MCDav1dAsmDir>
    <MCNasm Condition="'$(MCNasm)'==''">nasm</MCNasm>
  </PropertyGroup>
  <Target Name="MCDav1dX86Asm" BeforeTargets="PrepareForBuild" Condition="'@(MCDav1dAsm)'!=''">
    <Exec Command="&quot;$(MCNasm)&quot; -v" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MCNasmVersion" />
      <Output TaskParameter="ExitCode" PropertyName="_MCNasmExitCode" />
    </Exec>
    <Message Importance="high" Condition="'$(_MCNasmExitCode)'=='0'"
             Text="dav1d: its x86-64 assembly, by $(_MCNasmVersion)" />
    <Message Importance="high" Condition="'$(_MCNasmExitCode)'!='0'"
             Text="dav1d: no NASM ($(MCNasm)), so its C code alone (the HD movies decode several times slower)" />
    <ItemGroup Condition="'$(_MCNasmExitCode)'=='0'">
      <CustomBuild Include="@(MCDav1dAsm)">
        <Command>"$(MCNasm)" -f win64 -Xvc -I"$(MCLibDir)dav1d-1.5.4/" -I"$(MCLibDir)dav1d-1.5.4\src/" -o "$(MCDav1dAsmDir)%(MCDav1dAsm.Filename).obj" "%(MCDav1dAsm.FullPath)"</Command>
        <Outputs>$(MCDav1dAsmDir)%(MCDav1dAsm.Filename).obj</Outputs>
        <AdditionalInputs>%(MCDav1dAsm.FullPath);$(MCLibDir)dav1d-1.5.4\config.asm;$(MCLibDir)dav1d-1.5.4\src\ext\x86\x86inc.asm;$(MCLibDir)dav1d-1.5.4\src\x86\filmgrain_common.asm</AdditionalInputs>
        <Message>Assembling %(MCDav1dAsm.Filename).asm (NASM)</Message>
        <LinkObjects>true</LinkObjects>
        <BuildInParallel>true</BuildInParallel>
      </CustomBuild>
      <ClCompile Condition="$([System.String]::Copy('%(ClCompile.FullPath)').Contains('\dav1d-1.5.4\'))">
        <PreprocessorDefinitions>MC_DAV1D_X86_ASM;%(ClCompile.PreprocessorDefinitions)</PreprocessorDefinitions>
      </ClCompile>
    </ItemGroup>
    <MakeDir Directories="$(MCDav1dAsmDir)" Condition="'$(_MCNasmExitCode)'=='0'" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
