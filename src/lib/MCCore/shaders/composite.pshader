// The composite of the screen: the screen (UI) in palette indices over the world view's surface, then the palette.
//
// Drawn by MCVulkanPresenter into the frame texture, with quad.vshader: once over the whole target without an
// underlay, then over each underlay's rectangle with it. The target is the screen's size, or, when the screen is shown
// scaled up (a UI held under the window's height, MCDisplay::SetMaxHeight), the window pixels the view covers: each
// target pixel then shows the screen pixel under its centre (screenMap), while the world keeps the window's resolution.
// A screen pixel other than the key (255) is shown as it is. Over an underlay, a key pixel shows the world pixel under
// the target pixel's centre (nearest), mapped through the op table its screen pixel's op names (row 0 is the
// identity): a translucent UI draw over the world recorded its palette table there. This is
// MCRenderer::ComposeUnderlays (at the screen's size) and MCComposeScaled (scaled), which the CPU uses for
// screenshots, tests and the software renderer, done per pixel.
//
// Two sources (mode.y): the software renderer's pixels uploaded each frame (the screen, the op plane and the world
// R8), or the GPU renderer's own surfaces' colours (MCVulkanRenderer: premultiplied RGBA, see draw.pshader), where the
// screen is simply drawn over the world by its alpha (its key pixels are transparent, its translucent ones partly).
//
// Bindings (SDL GPU, SPIR-V): textures and samplers in space2, fragment uniforms in space3. A replacement in the
// shaders folder (composite.spv) must keep them.

// The screen: one palette index per pixel (red), or the GPU's colours.
Texture2D<float4> screenTex : register(t0, space2);
SamplerState screenSampler : register(s0, space2);
// The screen's op plane: one byte per screen pixel; with the GPU's surfaces, over an underlay, the GPU world's palette
// indices (port-only, HD lighting's living water: its index target, the size of its colours).
Texture2D<float> opTex : register(t1, space2);
SamplerState opSampler : register(s1, space2);
// The world view's surface (red, or the GPU's colours; unused without an underlay).
Texture2D<float4> worldTex : register(t2, space2);
SamplerState worldSampler : register(s2, space2);
// The op tables: 256 x 256, row = op, column = world index (unused with the GPU's surfaces).
Texture2D<float> tableTex : register(t3, space2);
SamplerState tableSampler : register(s3, space2);
// The palette, 256 x 1, as shown (gamma applied).
Texture2D<float4> paletteTex : register(t4, space2);
SamplerState paletteSampler : register(s4, space2);
// Port-only (HD lighting): the GPU world's bloom, its bright pass at half its size with its mips (linear; unused
// without a bloom).
Texture2D<float4> bloomTex : register(t5, space2);
SamplerState bloomSampler : register(s5, space2);

// The most lights (MCSceneLights::MaxLights): lights holds three float4s for each.
static const uint MaxLights = 64;
// The most fires in heat (MCSceneLights::MaxHeat).
static const uint MaxHeat = 16;

cbuffer Composite : register(b0, space3)
{
    // The screen's size in pixels (xy); the screen texture's allocated size (zw).
    float4 screenSize;
    // The screen pixel of target pixel p is xy + floor((p + 0.5) * zw): the view's corner (xy) and the screen pixels
    // per target pixel (zw; 1 at the screen's size).
    float4 screenMap;
    // The underlay's rectangle on the target: left, top, width, height.
    float4 shown;
    // The world surface's size in pixels (xy); the world texture's allocated size (zw).
    float4 worldSize;
    // x: 1 when drawing an underlay's rectangle, 0 for the screen alone, 2 for the bloom's bright pass of the GPU
    // world (BrightPass). y: 1 when the textures are the GPU renderer's surfaces. zw: the screen texture's pixels per screen pixel (port-only: above 1 for a sharp screen,
    // drawn at the size it's shown; 0 or 1 otherwise).
    float4 mode;
    // The colour cycle (the water's, MCColorCycle): x the first index cycled, y the step (-1: none). Index x + i
    // shows the colour of cycleSources[(i + y) & 7] (one source a component).
    int4 cycle;
    uint4 cycleSources[2];
    // The screen fade (MCDisplay::SetFade): x, the amount taken off every component of the finished colour (0 none,
    // 1 black). The scene fades between screens (aSystem::fadeDownCurrentPalette) are done here, not in the palette.
    float4 fade;
    // Port-only (HD lighting, sprite/MCSceneLights.h): x, the lights in lights (0 none); y, their strength; z, the
    // world's own light (1 as drawn); w, the screen width a ground distance takes per screen height it takes (1 / the
    // view's tilt).
    float4 lighting;
    // The lights' tone: x, what the air scatters back even off black ground; y, the knee above which lit colours (or
    // the world's own, when brighter) are eased toward white instead of clipped; z, the most light a surface takes
    // (light piling up from many lights eases toward it); w, the brightness above which a pixel is taken for a light
    // itself (a glow, a fireball) and keeps its own brightness, taking none of the light at white.
    float4 lightTone;
    // How the lights take the world's relief: x, the height (in the world's texels) a step from black to white in its own
    // shading stands for, so a surface brighter toward a light faces it (0: lit as flat); y, the texels between the
    // pixels its slope is taken across.
    float4 lightFacing;
    // How the lights colour the world, x: how much more of their hue it takes, its brightness kept. The bloom of the
    // GPU world: y, its strength (0 none); z, the brightness (a pixel's brightest component's) a pixel blooms above.
    float4 lightLook;
    // The bloom's texture: its size in use (xy, half the world's) and allocated (zw).
    float4 bloomSize;
    // The heat haze: x, the most a world sample shimmers, and y, the length of its waves (texels); z, the game's time
    // (seconds); w, the fires in heat.
    float4 haze;
    // The living water (MCLighting::Water): x, its strength (0 as the original drew it); y, how far its colour cycle has
    // gone toward its next step (0 to 1).
    float4 water;
    // The ground's map: the world texel of the map's middle (xy); then the meters east (xy) and north (zw) a texel off
    // it lies, as east = dot(groundAxes.xy, offset), north = dot(groundAxes.zw, offset).
    float4 ground;
    float4 groundAxes;
    // The clouds' shadows (CloudsAt): x, how much of the world's own light one takes away (0 none); y, the share of the
    // ground under them; z, how big they are (meters); w, how fast they drift (meters a second).
    float4 clouds;
    // Port-only (HD particles' shake, MCParticles::ShownShake): xy, the world's texels the world shown is moved by.
    float4 shake;
    // Port-only (HD lighting's time of day, MCLighting::AmbientTint and AmbientGrey): the world's own light's colour
    // (rgb, times lighting.z; white by day, the moon's blue at night) and how much of their colour the world's own
    // colours lose in it (w: 0 by day).
    float4 ambientLook;
    // Port-only (HD lighting's headlights, MCLighting::AirBeams): x, how much the spotlights' beams show in the air (0
    // none).
    float4 airBeams;
    // One a fire, in the world's texels: its flames' centre (xy), and how far to each side of it (z) and above it (w)
    // the air shimmers.
    float4 heat[MaxHeat];
    // Three a light, in the world's texels: the ground under it (x0 y0 x1 y1: a point, or a beam's ends); its height
    // and reach (xy), and a spotlight's aim, from the ground under it to where its beam's middle meets the ground (zw: 0
    // for a light that shines every way); its colour times its strength (rgb, a spotlight's where its beam's middle
    // meets the ground), and the cosine of the angle off its beam's middle at which a spotlight has faded out (w).
    float4 lights[MaxLights * 3];
};

// mode.x for the bloom's bright pass.
static const float BrightPass = 2.0;
// The brightness the relief takes for height, and the grey a light's hue is taken from.
static const float3 Luma = float3(0.299, 0.587, 0.114);
// A light's pool falls off as a light's at a height does, s^2 / (d^2 + s^2), s its height or, from a light lower than
// this much of its reach, that much of its reach; faded out to nothing at its reach.
static const float LightSoftness = 0.3;

// A spotlight's beam is full within this share of the way from its edge to its middle (MCSceneLights' SpotFull); the
// ground nearer it than where its beam's middle meets the ground takes at most SpotMost times the light there.
static const float SpotFull = 0.5;
static const float SpotMost = 1.5;

// A spotlight's light on the ground off (along the ground) from the ground under it, as a share of its light where its
// beam's middle meets the ground: the lamp height above the ground, its beam aimed at spot (from the ground under it),
// fading out at edge (the cosine off its middle). Within the beam, falling off as the square of the distance from the
// lamp: the ground it lights starts ahead of the lamp and widens as it goes.
float SpotPool(float2 off, float height, float2 spot, float edge)
{
    const float3 ray = float3(off, -height);
    const float3 aim = float3(spot, -height);
    const float lengths = sqrt(dot(ray, ray) * dot(aim, aim));

    if (lengths <= 0.0)
    {
        return 0.0;
    }

    const float beam = smoothstep(edge, lerp(edge, 1.0, SpotFull), dot(ray, aim) / lengths);
    return beam * min(dot(aim, aim) / dot(ray, ray), SpotMost);
}

// A spotlight's beam in the air fades out this far past where its middle meets the ground (a share of the way from its
// lamp), widens from this many texels at its lamp, and is full within this share of its width. Aimed away from the eye
// (its share up the screen from AirBeamHideFrom to AirBeamHidden), it fades out, behind its unit (as the lamp,
// MCSceneLights' LampHideFrom and LampHidden).
static const float AirBeamLength = 1.1;
static const float AirBeamLampWidth = 1.0;
static const float AirBeamFull = 0.4;
static const float AirBeamHideFrom = 0.2;
static const float AirBeamHidden = 0.7;

// The light the spotlights' beams scatter from the air toward the eye at a world texel (airBeams.x of it): each beam on
// the screen from its lamp (its height above the ground under it) to where its middle meets the ground, widening as its
// beam does and fading as it goes.
float3 AirBeamsAt(float2 texel)
{
    if (airBeams.x <= 0.0)
    {
        return float3(0.0, 0.0, 0.0);
    }

    float3 sum = float3(0.0, 0.0, 0.0);
    const uint count = min((uint)lighting.x, MaxLights);

    for (uint i = 0; i < count; ++i)
    {
        const float4 shape = lights[i * 3 + 1];
        const float4 color = lights[i * 3 + 2];

        if (color.w <= 0.0 || all(shape.zw == 0.0))
        {
            continue;
        }

        const float2 ground = lights[i * 3].xy;
        const float2 lamp = ground - float2(0.0, shape.x);
        const float2 beam = ground + shape.zw - lamp;
        const float length2 = dot(beam, beam);
        const float t = dot(texel - lamp, beam) / length2;

        if (t <= 0.0 || t >= AirBeamLength)
        {
            continue;
        }

        // Its half width there: the beam's angle (edge, its cosine) over the way from the lamp.
        const float spread = sqrt(max(1.0 - color.w * color.w, 0.0)) / color.w;
        const float width = AirBeamLampWidth + t * sqrt(length2) * spread;
        const float across = length(texel - (lamp + beam * t)) / width;
        const float along = 1.0 - t / AirBeamLength;
        const float shows = 1.0 - smoothstep(AirBeamHideFrom, AirBeamHidden, -beam.y * rsqrt(length2));
        sum += color.rgb * (along * shows * (1.0 - smoothstep(AirBeamFull, 1.0, across)));
    }

    return sum * airBeams.x * lighting.y;
}

// The light at a world texel whose ground rises by slope (brightness a texel along the ground): every light's pool on
// the ground under it, softer the higher it is, more on a slope facing it and less on one facing away; a spotlight's
// where its beam meets the ground (SpotPool).
float3 LightAt(float2 texel, float2 slope)
{
    float3 sum = float3(0.0, 0.0, 0.0);
    const uint count = min((uint)lighting.x, MaxLights);
    // Screen heights stretched to the ground distances they show.
    const float2 ground = float2(1.0, lighting.w);
    const float2 at = texel * ground;

    for (uint i = 0; i < count; ++i)
    {
        const float4 ends = lights[i * 3];
        const float4 shape = lights[i * 3 + 1];
        const float2 a = ends.xy * ground;
        const float2 ab = ends.zw * ground - a;
        const float length2 = dot(ab, ab);
        const float t = length2 > 0.0 ? saturate(dot(at - a, ab) / length2) : 0.0;
        const float2 off = at - (a + ab * t);
        const float d2 = dot(off, off);
        const float reach2 = max(shape.y * shape.y, 1.0);

        if (d2 < reach2)
        {
            const float soft = max(shape.x, shape.y * LightSoftness);
            const float x2 = d2 / reach2;
            const float fade = 1.0 - x2 * x2;
            // The slope's rise toward the light (off points away from it), at the light's angle above the ground.
            const float facing = max(1.0 + lightFacing.x * dot(slope, off) * rsqrt(d2 + soft * soft), 0.0);
            const float4 color = lights[i * 3 + 2];
            const float2 spot = shape.zw * ground;
            const float pool = color.w > 0.0 && any(spot != 0.0) ? SpotPool(off, shape.x, spot, color.w)
                                                                 : soft * soft / (d2 + soft * soft);
            sum += color.rgb * (fade * fade * pool * facing);
        }
    }

    return sum;
}

// How much a colour is a light's own (a glow, a fireball): 0 below lightTone.w's brightness, 1 at white.
float SelfLit(float3 color)
{
    return smoothstep(lightTone.w, 1.0, max(color.r, max(color.g, color.b)));
}

// The air over a fire starts to shimmer this much of its rise below the flames' centre, and fades out from this much of
// it above.
static const float HazeBelow = 0.4;
static const float HazeFadeFrom = 0.4;
// The haze's waves rise this fast (radians a second); they bend as they go, along waves across the screen this many
// times as long, swinging this many radians this fast. A sample shimmers up and down this much of how far it does
// across.
static const float HazeSpeed = 7.0;
static const float HazeBendLength = 1.7;
static const float HazeBend = 1.2;
static const float HazeBendSpeed = 2.3;
static const float HazeUpDown = 0.35;
static const float TwoPi = 6.2831853;
// How much of the lights a water glint at its brightest sends back (LivingWater, Lit).
static const float WaterLightGlint = 2.5;

// How far the air over the fires (haze) moves the world's sample at a world texel: rising waves, bent as they go,
// strongest just above the flames.
float2 HazeAt(float2 texel)
{
    const uint count = min((uint)haze.w, MaxHeat);
    float weight = 0.0;

    for (uint i = 0; i < count; ++i)
    {
        const float4 fire = heat[i];
        const float side = (texel.x - fire.x) / fire.z;
        const float up = (fire.y - texel.y) / fire.w;

        if (abs(side) < 1.0 && up > -HazeBelow && up < 1.0)
        {
            const float across = 1.0 - side * side;
            weight = max(weight, across * across * smoothstep(-HazeBelow, 0.0, up) *
                                     (1.0 - smoothstep(HazeFadeFrom, 1.0, up)));
        }
    }

    if (weight <= 0.0)
    {
        return float2(0.0, 0.0);
    }

    const float2 wave = texel * (TwoPi / haze.y);
    const float bend = HazeBend * sin(wave.x / HazeBendLength + haze.z * HazeBendSpeed);
    // A phase growing up the screen as time goes: the waves rise.
    const float phase = wave.y + haze.z * HazeSpeed + bend;
    return haze.x * weight * float2(sin(phase), HazeUpDown * cos(phase + wave.x));
}

// A colour brighter than this (its brightest component) is a light's own to the clouds' shadows, fully at white: they
// darken the ground's brightest colours (sand, snow) as they do the rest.
static const float CloudSpareFrom = 0.9;

// The world's own light: its strength (lighting.z) in its colour (ambientLook.rgb).
float3 AmbientLight()
{
    return lighting.z * ambientLook.rgb;
}

// The world's colour at a texel (sloped as SlopeAt finds, shade of the lights reaching it: the GPU world's alpha, which
// a unit's shadow takes down) in the world's own light and the lights' (lightTone): lit as a surface of that colour, the
// light's scatter added, and what rises above the knee eased toward white. In the world's own light its colours lose
// ambientLook.w of their colour (the lights show them in full). A light's own bright pixels keep their brightness and
// colour: the world's dimming and the lights pass them by. Water's glints (LivingWater) send back this much more of the
// light, times WaterLightGlint. The clouds' shadows leave cloudLight of the world's own light (CloudsAt), the lights'
// unchanged.
float3 Lit(float3 world, float2 texel, float2 slope, float shade, float glint, float3 cloudLight)
{
    const float3 ambient = AmbientLight();

    if (lighting.x <= 0.0 && all(ambient == 1.0) && ambientLook.w <= 0.0 && all(cloudLight == 1.0))
    {
        return world;
    }

    const float selfLit = SelfLit(world);
    const float3 own = lerp(world, dot(world, Luma), ambientLook.w * (1.0 - selfLit));
    const float3 base = own * lerp(ambient, 1.0, selfLit) *
                        lerp(cloudLight, 1.0, smoothstep(CloudSpareFrom, 1.0, max(world.r, max(world.g, world.b))));
    const float most = max(lightTone.z, 0.001);
    const float3 light = most * (1.0 - exp(-LightAt(texel, slope) * lighting.y * shade / most));
    // The light's hue, its colour less its grey: more of it shifts what it lights toward its colour, brightening nothing.
    const float3 hue = light - dot(light, Luma);
    const float3 lit = base + world * (light + hue * lightLook.x) * (1.0 - selfLit) + light * lightTone.x +
                       light * glint * WaterLightGlint;
    const float3 knee = min(max(base, lightTone.y), 0.999);
    const float3 over = max(lit - knee, 0.0);
    return min(lit, knee) + (1.0 - knee) * (1.0 - exp(-over / (1.0 - knee)));
}

// The finished colour through the screen fade.
float4 Faded(float3 color)
{
    return float4(saturate(color - fade.x), 1.0);
}

uint Byte(float value)
{
    return (uint)round(value * 255.0);
}

float4 TexelAt(Texture2D<float4> tex, SamplerState samp, float2 texel, float2 size)
{
    return tex.Sample(samp, (texel + 0.5) / size);
}

// The GPU world between its texels (from its four nearest, blended), clamped to the surface.
float4 WorldBetween(float2 texel)
{
    const float2 last = worldSize.xy - 1.0;
    const float2 at = clamp(texel, 0.0, last);
    const float2 corner = floor(at);
    const float2 next = min(corner + 1.0, last);
    const float2 t = at - corner;
    const float4 top = lerp(TexelAt(worldTex, worldSampler, corner, worldSize.zw),
                            TexelAt(worldTex, worldSampler, float2(next.x, corner.y), worldSize.zw), t.x);
    const float4 bottom = lerp(TexelAt(worldTex, worldSampler, float2(corner.x, next.y), worldSize.zw),
                               TexelAt(worldTex, worldSampler, next, worldSize.zw), t.x);
    return lerp(top, bottom, t.y);
}

// The bloom's first level has a texel for BloomScale x BloomScale of the world's pixels (MCVulkanPresenter's).
static const uint BloomScale = 2;

// The bloom's bright pass: a texel of the bloom's texture holds the light of the GPU world's BloomScale x BloomScale
// pixels under it brighter than lightLook.z, the more the brighter they are.
float4 Bright(float2 texel)
{
    float3 sum = float3(0.0, 0.0, 0.0);

    for (uint i = 0; i < BloomScale * BloomScale; ++i)
    {
        const float2 at = min(texel * BloomScale + float2(i % BloomScale, i / BloomScale), worldSize.xy - 1.0);
        const float3 color = TexelAt(worldTex, worldSampler, at, worldSize.zw).rgb;
        sum += color * smoothstep(lightLook.z, 1.0, max(color.r, max(color.g, color.b)));
    }

    return float4(sum / (BloomScale * BloomScale), 1.0);
}

// The bloom's mips added at a world texel: from BloomFirst (its bright pixels' own light left out) to the last of
// BloomLevels (MCVulkanPresenter's), each spread twice as wide as the one before and weighing BloomFalloff of it (a
// glow mostly close by). Each is taken from four taps half its texel diagonally each way, which smooths its blocks.
static const uint BloomFirst = 1;
static const uint BloomLevels = 6;
static const float BloomFalloff = 0.6;
static const uint BloomTapCount = 4;
static const float2 BloomTaps[BloomTapCount] = {float2(-0.5, -0.5), float2(0.5, -0.5), float2(-0.5, 0.5),
                                                float2(0.5, 0.5)};

float3 BloomAt(float2 texel)
{
    if (lightLook.y <= 0.0)
    {
        return float3(0.0, 0.0, 0.0);
    }

    // The texel's centre in the bloom's first level's texels.
    const float2 at = (texel + 0.5) / BloomScale;
    float3 sum = float3(0.0, 0.0, 0.0);
    float weight = 1.0;
    float weights = 0.0;

    for (uint level = BloomFirst; level < BloomLevels; ++level)
    {
        const float size = (float)(1u << level);

        for (uint tap = 0; tap < BloomTapCount; ++tap)
        {
            sum += weight * bloomTex.SampleLevel(bloomSampler, (at + BloomTaps[tap] * size) / bloomSize.zw, level).rgb;
        }

        weights += weight;
        weight *= BloomFalloff;
    }

    return sum * (lightLook.y / (BloomTapCount * weights));
}

uint IndexAt(Texture2D<float> tex, SamplerState samp, float2 texel, float2 size)
{
    return Byte(tex.Sample(samp, (texel + 0.5) / size));
}

// The colour index shows, through the colour cycle.
float3 Shown(uint index)
{
    const uint cycled = index - (uint)cycle.x;

    if (cycle.y >= 0 && cycled < 8u)
    {
        const uint source = (cycled + (uint)cycle.y) & 7u;
        index = cycleSources[source >> 2][source & 3u];
    }

    return paletteTex.Sample(paletteSampler, float2((index + 0.5) / 256.0, 0.5)).rgb;
}

// The world's colour at a world texel (clamped to the surface), through the palette for the software renderer's.
float3 WorldAt(float2 texel)
{
    const float2 at = clamp(texel, 0.0, worldSize.xy - 1.0);
    const float4 world = worldTex.Sample(worldSampler, (at + 0.5) / worldSize.zw);
    return mode.y != 0.0 ? world.rgb : Shown(Byte(world.r));
}

// The relief's height at a world texel: its brightness, but a light's own pixels stand at centre's height (the texel the
// slope is for), or the ground by every glow would slope up to it and face away from its light.
float HeightAt(float2 texel, float centre)
{
    const float3 color = WorldAt(texel);
    return lerp(dot(color, Luma), centre, SelfLit(color));
}

// The slope of the world's relief at a world texel, its own shading taken for height (lightFacing): its brightness's
// rise a texel along the ground. None when nothing is lit or the lights take no relief.
float2 SlopeAt(float2 texel)
{
    if (lighting.x <= 0.0 || lightFacing.x == 0.0)
    {
        return float2(0.0, 0.0);
    }

    const float centre = dot(WorldAt(texel), Luma);
    const float step = lightFacing.y;
    const float across = HeightAt(texel + float2(step, 0.0), centre) - HeightAt(texel - float2(step, 0.0), centre);
    const float down = HeightAt(texel + float2(0.0, step), centre) - HeightAt(texel - float2(0.0, step), centre);
    // A texel down the screen is lighting.w texels along the ground.
    return float2(across, down / lighting.w) / (2.0 * step);
}

// Port-only (HD lighting): the living water (MCLighting::Water). The water is found by the world's indices: the
// original's water tiles are its blues (WaterBlues, mostly the first two) with its colour-cycled entries scattered over
// them (color/MCWaterCycle.h: FirstWaterColor and the seven after it), and no land tile has either. Its colour flows from
// one of the cycle's steps to the next instead of ticking; waves roll over it before a wind (laid on the ground in
// meters, so they move with it as the view scrolls); the art's own sparkles twinkle as they pass, glinting the sun's light
// and the lights'; it is paler in the shallows and foam rides along its shores.
static const uint FirstWaterBlue = 0x58;
static const uint WaterBlues = 6;
// The commonest of them: the water's own colour, the art's sparkles brighter than it.
static const uint CommonWaterBlue = 0x59;
static const uint FirstWaterColor = 0xd8;
static const uint WaterColors = 8;
// A water colour's component is taken as at least this when the flow scales the drawn colour by its change, which
// brightens it this many times at most.
static const float WaterFlowFloor = 0.02;
static const float WaterFlowMost = 4.0;
// The waves: three trains of crests, each rolling its own way (a unit direction, the first the wind's, east of north)
// this long and this fast (meters, meters a second), weighing this much. Each comes in sets: its crests swell and fade
// as slow noise drifting with it (WaveGroups times its length big) rises and falls. Their crests are bent by two
// layers of drifting noise (WarpSize meters big, up to WarpCycles of a wave) and narrowed (raised to CrestSharpness),
// leaving calm troughs between. Gusts (GustSize meters big, drifting with the wind at GustSpeed) leave patches calmer
// (CalmShare of the waves). The water darkens WaveTrough in a trough and brightens up to WaveCrest on a crest.
// The wind (MCSceneLights::WindEast and WindNorth), which the clouds drift before too.
static const float2 Wind = float2(0.9285, 0.3714);
static const float2 WaveDirections[3] = {Wind, float2(0.6846, 0.7290), float2(0.9943, -0.1068)};
static const float3 WaveLengths = float3(30.0, 13.0, 7.0);
static const float3 WaveSpeeds = float3(9.0, 6.0, 4.0);
static const float3 WaveWeights = float3(0.5, 0.35, 0.25);
static const float WaveGroups = 3.0;
// A set moves at half its waves' speed (as a group of real waves does), between these levels of its noise from calm to
// full; each train's sets come from their own part of the noise, this far apart.
static const float SetSpeed = 0.5;
static const float2 SetLevels = float2(0.2, 0.8);
static const float TrainApart = 17.0;
static const float WarpSize = 34.0;
static const float WarpCycles = 1.6;
// The warp's finer layer: this many times finer, weighing this much.
static const float2 WarpFine = float2(2.5, 0.5);
static const float CrestSharpness = 3.0;
static const float GustSize = 90.0;
static const float GustSpeed = 3.0;
static const float CalmShare = 0.45;
static const float2 GustLevels = float2(0.3, 0.7);
static const float WaveTrough = 0.1;
static const float WaveCrest = 1.0;
// The art's sparkles: a water pixel this much brighter than its blues (in Luma) is one, fully from this much more. They
// twinkle as fine moving noise (this big, drifting this fast) passes: dimmed to SparkleLow off its peaks, glinting from
// TwinkleFrom up; the sun's glint at its brightest adds this much white (in the world's own light).
static const float SparkleFrom = 0.06;
static const float SparkleSpan = 0.25;
static const float SparkleLow = 0.3;
static const float TwinkleSize = 5.0;
static const float2 TwinkleDrift = float2(4.0, -3.0);
static const float TwinkleFrom = 0.5;
static const float SunGlint = 1.0;
// The shore: the land around a water pixel is looked for in this many directions, this near (foam), and this near and
// far (the shallows, paler by this much at the shore), in meters.
static const uint ShoreDirections = 8;
static const float2 ShoreSteps[ShoreDirections] = {float2(1.0, 0.0), float2(0.7071, 0.7071), float2(0.0, 1.0),
                                                   float2(-0.7071, 0.7071), float2(-1.0, 0.0), float2(-0.7071, -0.7071),
                                                   float2(0.0, -1.0), float2(0.7071, -0.7071)};
// The least square meters a texel is taken to cover (the presenter sends no water for a view showing less).
static const float MinGroundArea = 1e-6;
static const float ShoreNear = 3.0;
static const float ShallowNear = 12.0;
static const float ShallowFar = 36.0;
static const float3 ShallowTint = float3(1.2, 1.4, 1.25);
// The foam: drifting noise this big (meters) and fast, from this much up, as pale as this, at most this much of the
// colour.
static const float FoamSize = 8.0;
static const float2 FoamDrift = float2(1.5, 2.0);
static const float FoamFrom = 0.45;
static const float3 FoamColour = float3(0.5, 0.53, 0.55);
static const float FoamMost = 0.8;

// The world's palette index at a world texel: the GPU world's (its index target, bound as opTex) or the software
// renderer's pixel.
uint WorldIndexAt(float2 texel)
{
    const float2 at = clamp(round(texel), 0.0, worldSize.xy - 1.0);
    return mode.y != 0.0 ? IndexAt(opTex, opSampler, at, worldSize.zw)
                         : Byte(TexelAt(worldTex, worldSampler, at, worldSize.zw).r);
}

bool IsWater(uint index)
{
    return index - FirstWaterBlue < WaterBlues || index - FirstWaterColor < WaterColors;
}

// A water entry's colour at a step of its cycle.
float3 WaterCycleColour(uint entry, uint step)
{
    const uint source = (entry + step) & (WaterColors - 1u);
    const uint index = cycleSources[source >> 2][source & 3u];
    return paletteTex.Sample(paletteSampler, float2((index + 0.5) / 256.0, 0.5)).rgb;
}

// A value between 0 and 1 for a lattice point, the same every frame.
float LatticeHash(float2 lattice)
{
    const int2 p = int2(lattice);
    uint h = (uint)p.x * 1597334677u ^ (uint)p.y * 3812015801u;
    h ^= h >> 15;
    h *= 0x2c1b3c6du;
    h ^= h >> 12;
    return (float)h / 4294967295.0;
}

// Smooth value noise between 0 and 1.
float Noise(float2 p)
{
    const float2 corner = floor(p);
    const float2 f = p - corner;
    const float2 u = f * f * (3.0 - 2.0 * f);
    const float top = lerp(LatticeHash(corner), LatticeHash(corner + float2(1.0, 0.0)), u.x);
    const float bottom = lerp(LatticeHash(corner + float2(0.0, 1.0)), LatticeHash(corner + float2(1.0, 1.0)), u.x);
    return lerp(top, bottom, u.y);
}

// How much land lies around a world texel, this many meters away (the share of ShoreDirections): the ground's map
// (groundAxes) takes a square texel to its determinant's square meters.
float LandAround(float2 texel, float distance)
{
    const float area = abs(groundAxes.x * groundAxes.w - groundAxes.y * groundAxes.z);
    const float texels = distance * rsqrt(max(area, MinGroundArea));
    float land = 0.0;

    for (uint i = 0; i < ShoreDirections; ++i)
    {
        land += IsWater(WorldIndexAt(texel + ShoreSteps[i] * texels)) ? 0.0 : 1.0;
    }

    return land / ShoreDirections;
}

// The water's colour at a world texel (drawn as `color`), and how much it glints (0 to 1; Lit and main add the lights'
// and the sun's): `color` as it is but for water.
float3 LivingWater(float3 color, float2 texel, out float glint)
{
    glint = 0.0;
    const uint index = WorldIndexAt(texel);

    if (water.x <= 0.0 || !IsWater(index))
    {
        return color;
    }

    // The colour flowing toward the cycle's next step: the drawn colour (an HD one, recoloured as the entry shows now)
    // changed as the entry's colour changes.
    float3 flowing = color;

    if (cycle.y >= 0 && index - (uint)cycle.x < WaterColors)
    {
        const uint entry = index - (uint)cycle.x;
        const float3 now = WaterCycleColour(entry, (uint)cycle.y);
        const float3 next = WaterCycleColour(entry, (uint)cycle.y + 1u);
        flowing = color * min(lerp(now, next, water.y) / max(now, WaterFlowFloor), WaterFlowMost);
    }

    // The ground point (meters), the game's time, and the waves: each train's crests where its phase (along its
    // direction, rolling on, bent by the warp) comes round, in its sets, under the gusts.
    const float2 offset = texel - ground.xy;
    const float2 at = float2(dot(groundAxes.xy, offset), dot(groundAxes.zw, offset));
    const float time = haze.z;
    const float2 drift = time * WaveDirections[0] * WaveSpeeds.z;
    const float warp =
        WarpCycles * TwoPi * (Noise((at - drift) / WarpSize) + WarpFine.y * Noise((at + drift) * WarpFine.x / WarpSize));
    const float gust = lerp(CalmShare, 1.0, smoothstep(GustLevels.x, GustLevels.y,
                                                       Noise((at - time * WaveDirections[0] * GustSpeed) / GustSize)));
    float waves = 0.0;

    for (uint i = 0; i < 3; ++i)
    {
        // The second train bends the other way.
        const float along = dot(at, WaveDirections[i]) - time * WaveSpeeds[i];
        const float crest = pow(0.5 + 0.5 * sin(TwoPi * along / WaveLengths[i] + warp * (i == 1 ? -1.0 : 1.0)),
                                CrestSharpness);
        const float2 setAt = (at - SetSpeed * time * WaveSpeeds[i] * WaveDirections[i]) / (WaveGroups * WaveLengths[i]);
        const float set = smoothstep(SetLevels.x, SetLevels.y, Noise(setAt + float(i) * TrainApart));
        waves += WaveWeights[i] * set * crest;
    }

    waves *= gust;
    float3 shown = flowing * (1.0 - WaveTrough + WaveCrest * waves);

    // The art's sparkles twinkle, glinting at the twinkle's peaks on the waves' crests.
    const float sparkle = saturate((dot(color, Luma) - dot(Shown(CommonWaterBlue), Luma) - SparkleFrom) / SparkleSpan);
    const float twinkle = Noise((at + time * TwinkleDrift) / TwinkleSize);
    shown *= lerp(1.0, lerp(SparkleLow, 1.0, twinkle), sparkle);
    glint = sparkle * smoothstep(TwinkleFrom, 1.0, twinkle) * waves;

    // The shallows, paler toward the shore, and foam along it.
    const float nearLand = LandAround(texel, ShoreNear);
    const float shallow = max(LandAround(texel, ShallowNear), 0.5 * LandAround(texel, ShallowFar));
    shown *= lerp(float3(1.0, 1.0, 1.0), ShallowTint, saturate(max(nearLand, shallow)));
    const float foam = saturate(2.0 * nearLand) * smoothstep(FoamFrom, 1.0, Noise(at / FoamSize + time * FoamDrift));
    shown = lerp(shown, FoamColour, foam * FoamMost);
    glint *= water.x * (1.0 - foam);
    return lerp(color, shown, water.x);
}

// Port-only (HD lighting): the clouds' shadows (GHdClouds, MCLighting::Clouds), drifting over the ground (laid on it in
// meters, as the water's waves) before the wind. They are fractal noise: CloudLayers layers, each twice as fine and half
// as strong as the one before and turned CloudTurn radians from it (hiding the noise's grid). Each finer one also slides
// across the wind at CloudShear of its speed, one way then the other, so the clouds' edges change as they go while the
// clouds keep the wind's speed. A ground point is under a cloud where the noise
// rises above the level that leaves clouds.y of the ground under them (CloudSpread: the noise's spread about its middle
// for a share of it, measured), fully at CloudEdge above it. Its shade is lit by the sky, bluer than the sun: it takes
// CloudShadeTint of clouds.x from each component.
static const uint CloudLayers = 5;
static const float CloudTurn = 0.6;
static const float CloudShear = 0.15;
static const float CloudSpread = 0.39;
static const float CloudEdge = 0.06;
// Each layer's own place in the noise, off the one before.
static const float2 CloudLayerApart = float2(17.3, -9.1);
static const float3 CloudShadeTint = float3(1.0, 0.97, 0.8);

// The world's own light the clouds leave at a world texel (1 where none lies).
float3 CloudsAt(float2 texel)
{
    if (clouds.x <= 0.0)
    {
        return float3(1.0, 1.0, 1.0);
    }

    const float2 offset = texel - ground.xy;
    const float2 at = float2(dot(groundAxes.xy, offset), dot(groundAxes.zw, offset));
    const float drift = haze.z * clouds.w;
    const float2 crosswind = float2(-Wind.y, Wind.x);
    const float2 turn = float2(cos(CloudTurn), sin(CloudTurn));
    float sum = 0.0;
    float weight = 0.5;
    float weights = 0.0;
    float scale = 1.0 / clouds.z;
    float2 axis = float2(1.0, 0.0);

    for (uint i = 0; i < CloudLayers; ++i)
    {
        const float slide = i == 0 ? 0.0 : ((i & 1u) != 0 ? CloudShear : -CloudShear);
        const float2 p = (at - drift * (Wind + crosswind * slide)) * scale;
        sum += weight * Noise(float2(dot(p, axis), dot(p, float2(-axis.y, axis.x))) + CloudLayerApart * float(i));
        weights += weight;
        weight *= 0.5;
        scale *= 2.0;
        axis = float2(axis.x * turn.x - axis.y * turn.y, axis.x * turn.y + axis.y * turn.x);
    }

    const float level = 0.5 + CloudSpread * (0.5 - clouds.y);
    const float cloud = smoothstep(level - 0.5 * CloudEdge, level + 0.5 * CloudEdge, sum / weights);
    return 1.0 - clouds.x * cloud * CloudShadeTint;
}

float4 main(float4 position : SV_Position) : SV_Target
{
    const float2 pixel = floor(position.xy);

    if (mode.x == BrightPass)
    {
        return Bright(pixel);
    }

    const float2 screenPixel = screenMap.xy + floor((pixel + 0.5) * screenMap.zw);
    // A sharp screen's texel holding this pixel's centre; else the screen pixel's.
    const float2 drawn = max(mode.zw, float2(1.0, 1.0));
    const float2 screenTexel =
        any(drawn != float2(1.0, 1.0)) ? floor((screenMap.xy + (pixel + 0.5) * screenMap.zw) * drawn) : screenPixel;
    const float4 screen = TexelAt(screenTex, screenSampler, screenTexel, screenSize.zw);
    // The world pixel under this pixel's centre: (2 * offset + 1) * surface / (2 * shown), as the CPU picks it.
    const float2 offset = pixel - shown.xy;
    const float2 world =
        clamp(floor((2.0 * offset + 1.0) * worldSize.xy / (2.0 * shown.zw)) - shake.xy, 0.0, worldSize.xy - 1.0);

    if (mode.y != 0.0)
    {
        // The GPU's colours: the screen over the world (where the air over a fire shimmers, as it moves it, and with
        // its bloom laid over it as a screen blend, but for a light's own pixels, which keep their colour rather than
        // whiten), or over the key's colour where there's no world.
        float3 under = Shown(255);

        if (mode.x != 0.0)
        {
            const float2 hazy = world + HazeAt(world + 0.5);
            const float4 lit =
                any(hazy != world) ? WorldBetween(hazy) : TexelAt(worldTex, worldSampler, world, worldSize.zw);
            float glint;
            const float3 seen = LivingWater(lit.rgb, hazy, glint);
            const float3 bloom = BloomAt(hazy) * (1.0 - SelfLit(seen));
            const float3 cloudLight = CloudsAt(hazy + 0.5);
            const float3 shone = Lit(seen, hazy + 0.5, SlopeAt(hazy), lit.a, glint, cloudLight) +
                                 glint * SunGlint * AmbientLight() * cloudLight + AirBeamsAt(hazy + 0.5);
            under = 1.0 - (1.0 - saturate(shone)) * (1.0 - bloom);
        }

        return Faded(saturate(screen.rgb + under * (1.0 - screen.a)));
    }

    uint index = Byte(screen.r);

    if (mode.x != 0.0 && index == 255)
    {
        // The world pixel the air over a fire shimmers to (palette indices don't blend).
        const float2 hazy = clamp(round(world + HazeAt(world + 0.5)), 0.0, worldSize.xy - 1.0);
        index = Byte(TexelAt(worldTex, worldSampler, hazy, worldSize.zw).r);
        const uint op = IndexAt(opTex, opSampler, screenPixel, screenSize.zw);
        index = IndexAt(tableTex, tableSampler, float2(index, op), float2(256.0, 256.0));
        float glint;
        const float3 seen = LivingWater(Shown(index), hazy, glint);
        const float3 cloudLight = CloudsAt(hazy + 0.5);
        return Faded(Lit(seen, hazy + 0.5, SlopeAt(hazy), 1.0, glint, cloudLight) +
                     glint * SunGlint * AmbientLight() * cloudLight + AirBeamsAt(hazy + 0.5));
    }

    return Faded(Shown(index));
}
