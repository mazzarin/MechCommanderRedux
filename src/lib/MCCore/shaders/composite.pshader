// The composite of the screen: the screen (UI) in palette indices over the world view's surface, then the palette.
//
// Drawn by MCVulkanPresenter into the frame texture, with quad.vshader: once over the whole target without an
// underlay, then over each underlay's rectangle with it. The target is the screen's size, or, when the screen is shown
// scaled up (a UI held under the window's height, MCDisplay::SetMaxHeight), the window pixels the view covers: each
// target pixel then shows the screen pixel under its centre (screenMap), while the world keeps the window's resolution.
// A screen pixel other than the key (255) is shown as it is. Over an underlay, a key pixel shows the world pixel under
// the target pixel's centre (nearest), mapped through the op table its screen pixel's op names (row 0 is the
// identity): a translucent UI draw over the world recorded its palette table there. This is
// MCRenderer::ComposeUnderlays (at the screen's size) and MCComposeScaled (scaled), which the CPU uses for
// screenshots, tests and the software renderer, done per pixel.
//
// Two sources (mode.y): the software renderer's pixels uploaded each frame (the screen, the op plane and the world
// R8), or the GPU renderer's own surfaces' colours (MCVulkanRenderer: premultiplied RGBA, see draw.pshader), where the
// screen is simply drawn over the world by its alpha (its key pixels are transparent, its translucent ones partly).
//
// Bindings (SDL GPU, SPIR-V): textures and samplers in space2, fragment uniforms in space3. A replacement in the
// shaders folder (composite.spv) must keep them.

// The screen: one palette index per pixel (red), or the GPU's colours.
Texture2D<float4> screenTex : register(t0, space2);
SamplerState screenSampler : register(s0, space2);
// The screen's op plane: one byte per screen pixel (unused with the GPU's surfaces).
Texture2D<float> opTex : register(t1, space2);
SamplerState opSampler : register(s1, space2);
// The world view's surface (red, or the GPU's colours; unused without an underlay).
Texture2D<float4> worldTex : register(t2, space2);
SamplerState worldSampler : register(s2, space2);
// The op tables: 256 x 256, row = op, column = world index (unused with the GPU's surfaces).
Texture2D<float> tableTex : register(t3, space2);
SamplerState tableSampler : register(s3, space2);
// The palette, 256 x 1, as shown (gamma applied).
Texture2D<float4> paletteTex : register(t4, space2);
SamplerState paletteSampler : register(s4, space2);

cbuffer Composite : register(b0, space3)
{
    // The screen's size in pixels (xy); the screen texture's allocated size (zw).
    float4 screenSize;
    // The screen pixel of target pixel p is xy + floor((p + 0.5) * zw): the view's corner (xy) and the screen pixels
    // per target pixel (zw; 1 at the screen's size).
    float4 screenMap;
    // The underlay's rectangle on the target: left, top, width, height.
    float4 shown;
    // The world surface's size in pixels (xy); the world texture's allocated size (zw).
    float4 worldSize;
    // x: 1 when drawing an underlay's rectangle, 0 for the screen alone. y: 1 when the textures are the GPU
    // renderer's surfaces. zw: the screen texture's pixels per screen pixel (port-only: above 1 for a sharp screen,
    // drawn at the size it's shown; 0 or 1 otherwise).
    float4 mode;
    // The colour cycle (the water's, MCColorCycle): x the first index cycled, y the step (-1: none). Index x + i
    // shows the colour of cycleSources[(i + y) & 7] (one source a component).
    int4 cycle;
    uint4 cycleSources[2];
    // The screen fade (MCDisplay::SetFade): x, the amount taken off every component of the finished colour (0 none,
    // 1 black). The scene fades between screens (aSystem::fadeDownCurrentPalette) are done here, not in the palette.
    float4 fade;
    // Port-only (HD lighting, sprite/MCSceneLights.h): x, the lights in lights (0 none); y, their strength; z, the
    // world's own light (1 as drawn); w, the screen width a ground distance takes per screen height it takes (1 / the
    // view's tilt).
    float4 lighting;
    // The lights' tone: x, what the air scatters back even off black ground; y, the knee above which lit colours (or
    // the world's own, when brighter) are eased toward white instead of clipped; z, the most light a surface takes
    // (light piling up from many lights eases toward it); w, the brightness above which a pixel is taken for a light
    // itself (a glow, a fireball) and keeps its own brightness, taking none of the light at white.
    float4 lightTone;
    // How the lights take the world's relief: x, the height (in the world's texels) a step from black to white in its own
    // shading stands for, so a surface brighter toward a light faces it (0: lit as flat); y, the texels between the
    // pixels its slope is taken across.
    float4 lightFacing;
    // Three a light, in the world's texels: the ground under it (x0 y0 x1 y1: a point, or a beam's ends); its height
    // and reach (xy); its colour times its strength (rgb).
    float4 lights[192];
};

// The most lights (MCSceneLights::MaxLights): lights holds three float4s for each.
static const uint MaxLights = 64;
// A light's pool falls off as a light's at a height does, s^2 / (d^2 + s^2), s its height or, from a light lower than
// this much of its reach, that much of its reach; faded out to nothing at its reach.
static const float LightSoftness = 0.3;

// The light at a world texel whose ground rises by slope (brightness a texel along the ground): every light's pool on
// the ground under it, softer the higher it is, more on a slope facing it and less on one facing away.
float3 LightAt(float2 texel, float2 slope)
{
    float3 sum = float3(0.0, 0.0, 0.0);
    const uint count = min((uint)lighting.x, MaxLights);
    // Screen heights stretched to the ground distances they show.
    const float2 ground = float2(1.0, lighting.w);
    const float2 at = texel * ground;

    for (uint i = 0; i < count; ++i)
    {
        const float4 ends = lights[i * 3];
        const float2 shape = lights[i * 3 + 1].xy;
        const float2 a = ends.xy * ground;
        const float2 ab = ends.zw * ground - a;
        const float length2 = dot(ab, ab);
        const float t = length2 > 0.0 ? saturate(dot(at - a, ab) / length2) : 0.0;
        const float2 off = at - (a + ab * t);
        const float d2 = dot(off, off);
        const float reach2 = max(shape.y * shape.y, 1.0);

        if (d2 < reach2)
        {
            const float soft = max(shape.x, shape.y * LightSoftness);
            const float x2 = d2 / reach2;
            const float fade = 1.0 - x2 * x2;
            // The slope's rise toward the light (off points away from it), at the light's angle above the ground.
            const float facing = max(1.0 + lightFacing.x * dot(slope, off) * rsqrt(d2 + soft * soft), 0.0);
            sum += lights[i * 3 + 2].rgb * (fade * fade * soft * soft / (d2 + soft * soft) * facing);
        }
    }

    return sum;
}

// The world's colour at a texel (sloped as SlopeAt finds) in the world's own light and the lights' (lightTone): lit as a
// surface of that colour, the light's scatter added, and what rises above the knee eased toward white. A light's own
// bright pixels keep their brightness: the world's dimming and the lights pass them by.
float3 Lit(float3 world, float2 texel, float2 slope)
{
    if (lighting.x <= 0.0 && lighting.z == 1.0)
    {
        return world;
    }

    const float selfLit = smoothstep(lightTone.w, 1.0, max(world.r, max(world.g, world.b)));
    const float3 base = world * lerp(lighting.z, 1.0, selfLit);
    const float most = max(lightTone.z, 0.001);
    const float3 light = most * (1.0 - exp(-LightAt(texel, slope) * lighting.y / most));
    const float3 lit = base + world * light * (1.0 - selfLit) + light * lightTone.x;
    const float3 knee = min(max(base, lightTone.y), 0.999);
    const float3 over = max(lit - knee, 0.0);
    return min(lit, knee) + (1.0 - knee) * (1.0 - exp(-over / (1.0 - knee)));
}

// The finished colour through the screen fade.
float4 Faded(float3 color)
{
    return float4(saturate(color - fade.x), 1.0);
}

uint Byte(float value)
{
    return (uint)round(value * 255.0);
}

float4 TexelAt(Texture2D<float4> tex, SamplerState samp, float2 texel, float2 size)
{
    return tex.Sample(samp, (texel + 0.5) / size);
}

uint IndexAt(Texture2D<float> tex, SamplerState samp, float2 texel, float2 size)
{
    return Byte(tex.Sample(samp, (texel + 0.5) / size));
}

// The colour index shows, through the colour cycle.
float3 Shown(uint index)
{
    const uint cycled = index - (uint)cycle.x;

    if (cycle.y >= 0 && cycled < 8u)
    {
        const uint source = (cycled + (uint)cycle.y) & 7u;
        index = cycleSources[source >> 2][source & 3u];
    }

    return paletteTex.Sample(paletteSampler, float2((index + 0.5) / 256.0, 0.5)).rgb;
}

// The world's colour at a world texel (clamped to the surface), through the palette for the software renderer's.
float3 WorldAt(float2 texel)
{
    const float2 at = clamp(texel, 0.0, worldSize.xy - 1.0);
    const float4 world = worldTex.Sample(worldSampler, (at + 0.5) / worldSize.zw);
    return mode.y != 0.0 ? world.rgb : Shown(Byte(world.r));
}

// The slope of the world's relief at a world texel, its own shading taken for height (lightFacing): its brightness's
// rise a texel along the ground. None when nothing is lit or the lights take no relief.
float2 SlopeAt(float2 texel)
{
    if (lighting.x <= 0.0 || lightFacing.x == 0.0)
    {
        return float2(0.0, 0.0);
    }

    const float3 luma = float3(0.299, 0.587, 0.114);
    const float step = lightFacing.y;
    const float across = dot(WorldAt(texel + float2(step, 0.0)) - WorldAt(texel - float2(step, 0.0)), luma);
    const float down = dot(WorldAt(texel + float2(0.0, step)) - WorldAt(texel - float2(0.0, step)), luma);
    // A texel down the screen is lighting.w texels along the ground.
    return float2(across, down / lighting.w) / (2.0 * step);
}

float4 main(float4 position : SV_Position) : SV_Target
{
    const float2 pixel = floor(position.xy);
    const float2 screenPixel = screenMap.xy + floor((pixel + 0.5) * screenMap.zw);
    // A sharp screen's texel holding this pixel's centre; else the screen pixel's.
    const float2 drawn = max(mode.zw, float2(1.0, 1.0));
    const float2 screenTexel =
        any(drawn != float2(1.0, 1.0)) ? floor((screenMap.xy + (pixel + 0.5) * screenMap.zw) * drawn) : screenPixel;
    const float4 screen = TexelAt(screenTex, screenSampler, screenTexel, screenSize.zw);
    // The world pixel under this pixel's centre: (2 * offset + 1) * surface / (2 * shown), as the CPU picks it.
    const float2 offset = pixel - shown.xy;
    const float2 world = clamp(floor((2.0 * offset + 1.0) * worldSize.xy / (2.0 * shown.zw)), 0.0, worldSize.xy - 1.0);

    if (mode.y != 0.0)
    {
        // The GPU's colours: the screen over the world, or over the key's colour where there's no world.
        const float3 under =
            mode.x != 0.0 ? Lit(TexelAt(worldTex, worldSampler, world, worldSize.zw).rgb, world + 0.5, SlopeAt(world))
                          : Shown(255);
        return Faded(saturate(screen.rgb + under * (1.0 - screen.a)));
    }

    uint index = Byte(screen.r);

    if (mode.x != 0.0 && index == 255)
    {
        index = Byte(TexelAt(worldTex, worldSampler, world, worldSize.zw).r);
        const uint op = IndexAt(opTex, opSampler, screenPixel, screenSize.zw);
        index = IndexAt(tableTex, tableSampler, float2(index, op), float2(256.0, 256.0));
        return Faded(Lit(Shown(index), world + 0.5, SlopeAt(world)));
    }

    return Faded(Shown(index));
}
