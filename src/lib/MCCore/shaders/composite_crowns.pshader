// Port-only (HDSway): a forest's crowns this frame, their points and sways, one texel a crown cell (MCVulkanPresenter's
// crowns pass; composite.pshader's CrownsPass), read by the composite's canopy (SwayedAt), alone. It is
// composite.pshader built for that pass, so its pixels don't pay for the composite's registers.

#define COMPOSITE_PASS COMPOSITE_CROWNS_PASS
#include "composite.pshader"
