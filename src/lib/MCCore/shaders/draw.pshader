// The Vulkan renderer's draws (MCVulkanRenderer), with instance.vshader: every pixel of a resolved draw command.
//
// A surface has two targets: its colours (RGBA8, premultiplied alpha: what the composite shows) and its palette
// indices (R8: what draws that read a surface, the terrain's fog test and the mirror comparison read). An opaque pixel
// writes the colour of its index (the frame's palette, through the colour cycle) and the index; on a surface shown over
// another (the screen over the world view), the key colour 255 is written transparent. A translucent pixel is alpha
// blended into the colours (the blend pipeline: ONE, ONE_MINUS_SRC_ALPHA) and leaves the index; nothing reads the
// target.
//
// Translucency follows AlphaPal.ini (InitAlphaLookup's entries, the alpha texture), not AlphaTable: a special colour
// is drawn as RGB * A over the pixel with 1 - B2 coverage, a colour-dodge entry (A and B2 both 0) as added light;
// colours 0 and 255 draw nothing, the rest are drawn as themselves. A table applied to the pixel under a draw
// (TableAfter: haze, fades) is drawn as the colour and coverage that fit what the table does to the palette (the fit
// texture, one a table row, made each frame).
//
// A surface may be drawn at another size than its window's (the world view, drawn at the size it's shown, the zoom
// being only that scale): each drawn pixel takes the window pixel under its centre, (2 * drawn + 1) * window /
// (2 * size drawn), the composite's rule, and is worked out as that window pixel. So the scaled surface holds what
// scaling the window's pixels would show. Reading such a surface as a source takes the drawn pixel holding a window
// pixel's centre.
//
// An HD art frame (port-only, sprite/MCHdArt.h) is drawn over the original shape's place: each drawn pixel takes the
// frame's colour at its centre, filtered between the frame's pixels, so the shape shows at the output's resolution.
// A translucent shape's frame leaves out its blended pixels, which the original's draw still blends (BlendedOnly),
// except one that holds them (HdLight: an effect's), whose pixels may add light (colour without coverage).
// A paint scheme's table recolours the pixels whose original index it changes. A terrain tile with HD colours
// (HdColors, terrain.vshader) writes the pixels and indices it always did, its colours filtered from the HD tile's.
// HD colours are corrected by their original index's colour now over the one the pack was made from (Corrected), so
// another palette, the colour cycle and the brightness show through; a menu's picture, made from its own screen's
// palette, shows as made (HdAsMade).
//
// A sharp glyph (port-only, platform/MCSharpText.h) is drawn over the glyph's place on a sharp screen (one drawn at the
// size it is shown): each drawn pixel takes the coverage of the glyph's strokes at its centre, filtered between the
// redrawn pixels, in the colour the glyph's table gives the font byte of the ink pixel nearest it.
//
// Bindings (SDL GPU, SPIR-V): textures and samplers in space2, fragment uniforms in space3.

// The source: an atlas page (red value, green state), a picture (red), a surface's indices (red), an HD art frame's
// original indices (red the index, green 1 where there is one; one texel an original pixel), or a glyph redrawn sharp
// (red the font byte, green the coverage).
Texture2D<float4> sourceTex : register(t0, space2);
SamplerState sourceSampler : register(s0, space2);
// The frame's tables: 256 wide, one row a table, row 0 the identity.
Texture2D<float4> tableTex : register(t1, space2);
SamplerState tableSampler : register(s1, space2);
// The alpha colours, two texels each (column = the colour): row 0 x the kind (0 nothing, 1 opaque, 2 blended), row 1
// the premultiplied colour and coverage.
Texture2D<float4> alphaTex : register(t2, space2);
SamplerState alphaSampler : register(s2, space2);
// The tables' fits, one texel a table row (row = the table's row): the premultiplied colour and coverage.
Texture2D<float4> fitTex : register(t3, space2);
SamplerState fitSampler : register(s3, space2);
// The palette, 256 x 2: row 0 as shown (gamma applied), row 1 the colours the HD art pack was made from.
Texture2D<float4> paletteTex : register(t4, space2);
SamplerState paletteSampler : register(s4, space2);
// The HD colours (premultiplied): an HD art frame's (its scale times its indices' size; BC7 frames padded to whole
// blocks), or the terrain's tiles at HdScale times their atlas places.
Texture2D<float4> hdTex : register(t5, space2);
SamplerState hdSampler : register(s5, space2);
// The terrain's second HD atlas (a big map's tiles past the first's), else hdTex again.
Texture2D<float4> hdTex2 : register(t6, space2);
SamplerState hdSampler2 : register(s6, space2);

cbuffer Frame : register(b0, space3)
{
    // The target window's size (xy) and the size its surface is drawn at (zw).
    int4 scale;
    // The same for the source when it is a surface; else 1, 1, 1, 1.
    int4 sourceScale;
    // The colour cycle (the water's, MCColorCycle): x the first index cycled, y the step (-1: none), z 1 when the key
    // colour is transparent on this surface. Index x + i shows the colour of cycleSources[(i + y) & 7].
    int4 cycle;
    uint4 cycleSources[2];
};

struct Input
{
    float4 position : SV_Position;
    nointerpolation int4 rect : TEXCOORD0;
    nointerpolation int4 source : TEXCOORD1;
    nointerpolation uint4 op : TEXCOORD2;
    nointerpolation int4 span : TEXCOORD3;
    nointerpolation uint4 walk : TEXCOORD4;
};

struct Output
{
    float4 color : SV_Target0;
    float4 index : SV_Target1;
};

// Kinds (op.x bits 0-3).
static const uint KindFill = 0;
static const uint KindHash = 1;
static const uint KindTexture = 2;
static const uint KindGouraud = 3;
static const uint KindTexelWalk = 4;
static const uint KindHd = 5;
static const uint KindSharpGlyph = 6;
// Port-only: a line's and an ellipse's colour pass at the output's resolution (SmoothShapePixel).
static const uint KindSmoothLine = 7;
static const uint KindSmoothEllipse = 8;
// Port-only: a textured polygon's picture (a tactical map's) shown from the HD art pack, turned and scaled (HdMapPixel).
static const uint KindHdMap = 9;
// Port-only: a game-drawn picture mapped with its key transparent (the fog of war), its edges smooth (SmoothMapPixel).
static const uint KindSmoothMap = 10;
// Port-only: a flat or Gouraud polygon (a laser's beam) at the output's resolution, its edges smooth (SmoothPolygonPixel).
static const uint KindSmoothPolygon = 11;

// Flags (op.x).
static const uint OpaqueSource = 1u << 4;
static const uint FillSkipped = 1u << 5;
static const uint SkipRunKey = 1u << 6;
static const uint TableBefore = 1u << 7;
static const uint SkipKeyAfterTable = 1u << 8;
static const uint ColorKey = 1u << 9;
static const uint UseColor = 1u << 10;
static const uint AlphaBlend = 1u << 12;
static const uint TableAfter = 1u << 13;
// The alpha colour is op.w, not the pixel's value.
static const uint GivenAlpha = 1u << 14;
// A terrain tile's colours from the HD art pack: op.w the scale, walk the tile's place in the atlas (x, y, w, h).
// (Bit 15 is the renderer's IndexOnly.)
static const uint HdColors = 1u << 16;
// A translucent shape whose coverage is taken between its pixels, so its edges are smooth at the output's resolution:
// walk its place in the source (x0, y0, x1, y1).
static const uint SmoothEdges = 1u << 17;
// Port-only, for a translucent shape drawn from the HD art pack: only its opaque pixels (drawn index-only under the HD
// frame), or only its blended ones (which the HD frame leaves out).
static const uint OpaqueOnly = 1u << 18;
static const uint BlendedOnly = 1u << 19;
// An HD frame's colours shown as made, not Corrected (a menu's picture, made from its own screen's palette).
static const uint HdAsMade = 1u << 20;
// Port-only: an HD art frame holding its blended pixels.
static const uint HdLight = 1u << 21;
// A smooth edge's coverage (the source pixels' smoothed, 0..1) ramps over this range, about a drawn pixel wide.
static const float EdgeLow = 0.3;
static const float EdgeHigh = 0.7;
// The most an HD colour channel is scaled by when today's colour differs from the pack's.
static const float MaxCorrection = 4.0;
// An effect's frame (HdLight) holds faint error in its empty parts (the network's and BC7's: up to about 5/255 of light
// and 4/255 of coverage), which the copies of an effect the game stacks on one place (a dying mech's critical hits,
// each with its own) would add up into a lit box. Coverage below its floor is none, and light loses its floor.
static const float LightFloor = 6.0 / 255.0;
static const float CoverageFloor = 4.5 / 255.0;

// The alpha colours' kinds.
static const uint AlphaNothing = 0;
static const uint AlphaOpaque = 1;

float4 Fetch(Texture2D<float4> tex, SamplerState samp, int2 texel)
{
    uint width;
    uint height;
    tex.GetDimensions(width, height);
    return tex.SampleLevel(samp, (float2(texel) + 0.5) / float2(width, height), 0);
}

uint Byte(float value)
{
    return (uint)round(value * 255.0);
}

uint Table(uint row, uint index)
{
    return Byte(Fetch(tableTex, tableSampler, int2(index, row)).r);
}

// The colour index shows, through the colour cycle.
float3 Shown(uint index)
{
    const uint cycled = index - (uint)cycle.x;

    if (cycle.y >= 0 && cycled < 8u)
    {
        const uint source = (cycled + (uint)cycle.y) & 7u;
        index = cycleSources[source >> 2][source & 3u];
    }

    return Fetch(paletteTex, paletteSampler, int2(index, 0)).rgb;
}

// An opaque pixel: its colour (none for the key on a surface shown over another) and its index.
Output Opaque(uint index)
{
    Output output;
    output.color = cycle.z != 0 && index == 255 ? float4(0.0, 0.0, 0.0, 0.0) : float4(Shown(index), 1.0);
    output.index = float4((float)index / 255.0, 0.0, 0.0, 0.0);
    return output;
}

// A blended pixel: premultiplied colour and coverage (the blend pipeline leaves the index).
Output Blended(float4 color)
{
    Output output;
    output.color = color;
    output.index = float4(0.0, 0.0, 0.0, 0.0);
    return output;
}

// The window pixel under drawn pixel p's centre, with sizes s (window xy, drawn zw).
int2 WindowPixel(int2 p, int4 s)
{
    return int2((2u * uint2(p) + 1u) * uint2(s.xy) / (2u * uint2(s.zw)));
}

// The drawn pixel holding window pixel t's centre.
int2 DrawnPixel(int2 t, int4 s)
{
    return int2((2u * uint2(t) + 1u) * uint2(s.zw) / (2u * uint2(s.xy)));
}

float4 FetchSource(int2 texel)
{
    return Fetch(sourceTex, sourceSampler, DrawnPixel(texel, sourceScale));
}

// The colour the HD art pack's pictures were made from for an index.
float3 MadeWith(uint index)
{
    return Fetch(paletteTex, paletteSampler, int2(index, 1)).rgb;
}

// An HD colour (premultiplied by a) made from original index `index`'s colour, as it shows now as index `shown` (the
// same, or a table's): the same index takes each channel's change between the pack's colour and today's; another (a
// paint scheme, the haze) takes its colour at the HD colour's brightness.
float3 Corrected(float3 color, float a, uint index, uint shown)
{
    const float3 then = MadeWith(index);

    if (shown == index)
    {
        return color * clamp(Shown(index) / max(then, 1.0 / 255.0), 0.0, MaxCorrection);
    }

    const float3 luma = float3(0.299, 0.587, 0.114);
    const float brightness = dot(color, luma) / max(a * dot(then, luma), 1.0 / 255.0);
    return saturate(Shown(shown) * brightness) * a;
}

// The palette indices TableShift fits a table's change of colour over: every 16th, from the 8th.
static const uint TableFitSamples = 16;
static const uint TableFitStep = 16;
static const uint TableFitFirst = 8;
// A channel varying less than this over the samples is shifted, not scaled.
static const float TableFitFlat = 1e-4;

// The change of colour table `row` makes, fitted a channel at a time over a sample of the palette (shown = k colour +
// m, least squares), applied to premultiplied colour `color` of coverage `a` (light, without coverage, is only scaled).
float3 TableShift(uint row, float3 color, float a)
{
    float3 sumX = float3(0.0, 0.0, 0.0);
    float3 sumY = float3(0.0, 0.0, 0.0);
    float3 sumXX = float3(0.0, 0.0, 0.0);
    float3 sumXY = float3(0.0, 0.0, 0.0);

    for (uint i = 0; i < TableFitSamples; i++)
    {
        const uint index = TableFitFirst + i * TableFitStep;
        const float3 x = Shown(index);
        const float3 y = Shown(Table(row, index));
        sumX += x;
        sumY += y;
        sumXX += x * x;
        sumXY += x * y;
    }

    const float n = (float)TableFitSamples;
    const float3 variance = sumXX - sumX * sumX / n;
    const float3 sloped = step(TableFitFlat, variance);
    const float3 k = lerp(float3(1.0, 1.0, 1.0), (sumXY - sumX * sumY / n) / max(variance, TableFitFlat), sloped);
    const float3 m = (sumY - k * sumX) / n;
    return saturate(k * color + m * a);
}

// The HD terrain's colour at a texel of atlas `atlas` (0 hdTex, 1 hdTex2), kept inside the tile's place (low, high).
float3 HdAtlasTexel(int2 texel, int2 low, int2 high, int atlas)
{
    const int2 at = clamp(texel, low, high);
    return atlas == 0 ? Fetch(hdTex, hdSampler, at).rgb : Fetch(hdTex2, hdSampler2, at).rgb;
}

// A terrain tile's pixel in HD colours (terrain.vshader): op.w the HD scale, walk.xy the tile's HD place and walk.zw its
// place in the atlas (the source's), span.xy its size and span.z its HD atlas; the index is `value` (original, through
// the haze's table), the HD colour the one made from `original`'s.
Output HdTerrainPixel(Input input, int2 target, uint original, uint value)
{
    const int hdScale = (int)input.op.w;
    const float2 window = (float2(target) + 0.5) * float2(scale.xy) / float2(scale.zw);
    const float2 local = float2(input.source.xy) + (window - float2(input.rect.xy)) - float2(input.walk.zw);
    const int2 low = int2(input.walk.xy);
    const int2 high = low + input.span.xy * hdScale - 1;
    const int atlas = input.span.z;
    const float2 at = float2(input.walk.xy) + local * (float)hdScale - 0.5;
    const int2 base = int2(floor(at));
    const float2 f = at - float2(base);
    const float3 top =
        lerp(HdAtlasTexel(base, low, high, atlas), HdAtlasTexel(base + int2(1, 0), low, high, atlas), f.x);
    const float3 bottom =
        lerp(HdAtlasTexel(base + int2(0, 1), low, high, atlas), HdAtlasTexel(base + int2(1, 1), low, high, atlas), f.x);

    Output output;
    output.color = float4(Corrected(lerp(top, bottom, f.y), 1.0, original, value), 1.0);
    output.index = float4((float)value / 255.0, 0.0, 0.0, 0.0);
    return output;
}

// Whether a source texel inside the shape's place (walk: x0, y0, x1, y1) is drawn, and its value.
bool DrawnTexel(Input input, int2 texel, out uint value)
{
    value = 0;

    if (any(texel < int2(input.walk.xy)) || any(texel > int2(input.walk.zw)))
    {
        return false;
    }

    const float4 sample = Fetch(sourceTex, sourceSampler, texel);
    value = Byte(sample.r);

    // A picture of indices (an opaque source): colours 0 and 255 draw nothing. An atlas page: the state says.
    if ((input.op.x & OpaqueSource) != 0)
    {
        return value != 0 && value != 255;
    }

    const uint state = Byte(sample.g);
    return state != 0 && state != 2;
}

// The cubic B-spline's weights for the four source pixels around a point a fraction f past the second.
float4 BSplineWeights(float f)
{
    const float f2 = f * f;
    const float f3 = f2 * f;
    return float4(1.0 - 3.0 * f + 3.0 * f2 - f3, 4.0 - 6.0 * f2 + 3.0 * f3, 1.0 + 3.0 * f + 3.0 * f2 - 3.0 * f3, f3) /
           6.0;
}

// Whether texel `texel` of what a smooth draw reads is drawn, and its value: a smooth-edged shape's (DrawnTexel), or a
// smooth map's texture texel (walk.zw its size) that isn't the key.
bool CoverageTexel(Input input, int2 texel, out uint value)
{
    if ((input.op.x & 15u) != KindSmoothMap)
    {
        return DrawnTexel(input, texel, value);
    }

    value = 0;

    if (any(texel < 0) || any(texel >= int2(input.walk.zw)))
    {
        return false;
    }

    value = Byte(FetchSource(texel).r);
    return value != 255u;
}

// The coverage around `at` (a place in the source's texels, less half a texel): the drawn texels (the 4 x 4 around it)
// smoothed by a cubic B-spline, which rounds the pixel steps into curves, then ramped so the edge is about a drawn pixel
// wide. `value` becomes the nearest drawn texel's.
float SmoothCoverage(Input input, float2 at, inout uint value)
{
    const int2 base = int2(floor(at));
    const float2 f = at - float2(base);
    const float4 wx = BSplineWeights(f.x);
    const float4 wy = BSplineWeights(f.y);
    float coverage = 0.0;
    bool found = false;
    float nearest = 1e9;

    for (int y = 0; y < 4; y++)
    {
        for (int x = 0; x < 4; x++)
        {
            uint tapValue;

            if (CoverageTexel(input, base + int2(x - 1, y - 1), tapValue))
            {
                coverage += wx[x] * wy[y];
                const float2 d = float2(x - 1, y - 1) - f;
                const float distance = dot(d, d);

                if (!found || distance < nearest)
                {
                    found = true;
                    nearest = distance;
                    value = tapValue;
                }
            }
        }
    }

    return smoothstep(EdgeLow, EdgeHigh, coverage);
}

// A smooth-edged shape's coverage at drawn pixel `target` (SmoothCoverage of its source pixels). `value` becomes a drawn
// neighbour's when the pixel under the centre isn't drawn.
float ShapeCoverage(Input input, int2 target, inout uint value)
{
    const float2 window = (float2(target) + 0.5) * float2(scale.xy) / float2(scale.zw);
    const float2 flip = float2(input.source.z < 0 ? 1.0 : 0.0, input.source.w < 0 ? 1.0 : 0.0);
    const float2 at =
        float2(input.source.xy) + flip + (window - float2(input.rect.xy)) * float2(input.source.zw) - 0.5;
    return SmoothCoverage(input, at, value);
}

// An HD art frame's colour at a texel, transparent outside its size, and where a keyed copy (port-only: an HD picture
// of a menu's art) leaves out the original's pixel of the key colour (keyed: op.x's ColorKey, the key op.y's bits
// 8-15). The frame's indices (the source) have a texel for hdScale x hdScale of its colours.
float4 HdTexel(int2 texel, int2 size, int hdScale, uint flags, uint key)
{
    if (any(texel < 0) || any(texel >= size))
    {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    if ((flags & ColorKey) != 0)
    {
        const float4 entry = Fetch(sourceTex, sourceSampler, texel / hdScale);

        if (Byte(entry.g) == 255u && Byte(entry.r) == key)
        {
            return float4(0.0, 0.0, 0.0, 0.0);
        }
    }

    return Fetch(hdTex, hdSampler, texel);
}

// An HD art frame's colour at `shape`, a place in the original's pixels (their centres at .5): between the four HD
// texels around it, recoloured as the original pixel under it shows now.
Output HdPixelAt(Input input, float2 shape)
{
    const uint hdScale = input.op.y & 255u;
    uint width;
    uint height;
    sourceTex.GetDimensions(width, height);
    const int2 original = int2((int)width, (int)height);
    const int2 size = original * (int)hdScale;

    // Between the four texels around the point (premultiplied, so the transparent ones add no colour).
    const float2 at = shape * (float)hdScale - 0.5;
    const int2 base = int2(floor(at));
    const float2 f = at - float2(base);
    const uint flags = input.op.x;
    const uint key = (input.op.y >> 8) & 255u;
    const int texelScale = (int)hdScale;
    const float4 top = lerp(HdTexel(base, size, texelScale, flags, key),
                            HdTexel(base + int2(1, 0), size, texelScale, flags, key), f.x);
    const float4 bottom = lerp(HdTexel(base + int2(0, 1), size, texelScale, flags, key),
                               HdTexel(base + int2(1, 1), size, texelScale, flags, key), f.x);
    float4 color = lerp(top, bottom, f.y);

    // A frame holding its blended pixels may add light where it has no coverage (its error adds none).
    if ((input.op.x & HdLight) != 0 && color.a < CoverageFloor)
    {
        color = float4(max(color.rgb - LightFloor, 0.0), 0.0);
    }

    if (color.a <= 0.0 && ((input.op.x & HdLight) == 0 || all(color.rgb <= 0.0)))
    {
        discard;
    }

    // The colour as the original pixel under it shows now: through a paint scheme's table, today's palette, cycle and
    // brightness.
    const int2 texel = clamp(int2(floor(shape)), int2(0, 0), original - 1);
    const float4 entry = Fetch(sourceTex, sourceSampler, texel);

    if (Byte(entry.g) == 255u && (input.op.x & HdAsMade) == 0)
    {
        const uint index = Byte(entry.r);
        const uint shown = (input.op.x & TableBefore) != 0 ? Table(input.op.z, index) : index;
        color.rgb = Corrected(color.rgb, color.a, index, shown);
    }
    else if (Byte(entry.g) != 255u && (input.op.x & TableBefore) != 0)
    {
        // A pixel without an index (an effect's blended one: smoke, dust) drawn through a table (the haze): the
        // table's change of colour, as near as one line a channel follows it.
        color.rgb = TableShift(input.op.z, color.rgb, color.a);
    }

    return Blended(color);
}

// An HD art frame's pixel: the source is the place in the original shape's bounds of the rectangle's first pixel and
// the steps per window pixel (negative: mirrored), op.y the frame's scale.
Output HdPixel(Input input, int2 target)
{
    // The drawn pixel's centre in window pixels, and in the shape's bounds (a mirrored step reads from the right).
    const float2 window = (float2(target) + 0.5) * float2(scale.xy) / float2(scale.zw);
    const float2 flip = float2(input.source.z < 0 ? 1.0 : 0.0, input.source.w < 0 ? 1.0 : 0.0);
    return HdPixelAt(input, float2(input.source.xy) + flip + (window - float2(input.rect.xy)) * float2(input.source.zw));
}

// Where drawn pixel `target`'s centre lies in a textured polygon's texture (KindHdMap, KindSmoothMap): the polygon's
// affine map of the window (u from span.xyz, v from span.w and walk.xy: floats; texel centres at .5).
float2 MappedPlace(Input input, int2 target)
{
    const float2 window = (float2(target) + 0.5) * float2(scale.xy) / float2(scale.zw);
    const float4 u = asfloat(input.span);
    const float2 v = asfloat(input.walk.xy);
    return float2(u.x * window.x + u.y * window.y + u.z, u.w * window.x + v.x * window.y + v.y);
}

// Port-only: a textured polygon's picture shown from the HD art pack (KindHdMap): the drawn pixel's place in the
// picture is the polygon's affine map of the window (u from span.xyz, v from span.w and walk.xy: floats; texel centres at .5), then
// read as HdPixel reads a frame; nothing outside the picture.
Output HdMapPixel(Input input, int2 target)
{
    const float2 picture = MappedPlace(input, target);
    uint width;
    uint height;
    sourceTex.GetDimensions(width, height);

    if (any(picture < 0.0) || any(picture >= float2((float)width, (float)height)))
    {
        discard;
    }

    return HdPixelAt(input, picture);
}

// Port-only: a game-drawn picture mapped with its key transparent (the fog of war, KindSmoothMap), its colour pass at
// the output's resolution: its drawn texels' edges rounded as a smooth-edged shape's are (its indices were written by
// the walk, index-only). Premultiplied, through the blend pipeline.
Output SmoothMapPixel(Input input, int2 target)
{
    uint value = 255u;
    const float coverage = SmoothCoverage(input, MappedPlace(input, target) - 0.5, value);

    if (coverage <= 0.0)
    {
        discard;
    }

    return Blended(float4(Shown(value), 1.0) * coverage);
}

// A sharp glyph's colour field, above its scale (the low byte): the layer runs on past the glyph's border
// (MCVulkanRenderer.cpp's SharpGlyphRunsOn).
static const uint SharpGlyphRunsOn = 1u << 8;

// A redrawn glyph's texel (red the font byte, green the coverage): nothing outside its size, or, for a layer that runs
// on past the glyph's border (a box behind letters), its border's, so it runs into the next glyph's without fading.
float4 GlyphTexel(int2 texel, int2 size, bool runsOn)
{
    if (runsOn)
    {
        return Fetch(sourceTex, sourceSampler, clamp(texel, int2(0, 0), size - 1));
    }

    if (any(texel < 0) || any(texel >= size))
    {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    return Fetch(sourceTex, sourceSampler, texel);
}

// A sharp glyph's pixel: the source is the place in the glyph of the rectangle's first pixel, op.y the redrawn
// glyph's scale (and SharpGlyphRunsOn), op.z the glyph's table.
Output SharpGlyphPixel(Input input, int2 target)
{
    const float2 window = (float2(target) + 0.5) * float2(scale.xy) / float2(scale.zw);
    const float2 glyph = float2(input.source.xy) + (window - float2(input.rect.xy));
    const float glyphScale = (float)(input.op.y & 255u);
    uint width;
    uint height;
    sourceTex.GetDimensions(width, height);
    const int2 size = int2((int)width, (int)height);

    const bool runsOn = (input.op.y & SharpGlyphRunsOn) != 0;
    const float2 at = glyph * glyphScale - 0.5;
    const int2 base = int2(floor(at));
    const float2 f = at - float2(base);
    const float top = lerp(GlyphTexel(base, size, runsOn).g, GlyphTexel(base + int2(1, 0), size, runsOn).g, f.x);
    const float bottom =
        lerp(GlyphTexel(base + int2(0, 1), size, runsOn).g, GlyphTexel(base + int2(1, 1), size, runsOn).g, f.x);
    const float coverage = lerp(top, bottom, f.y);

    if (coverage <= 0.0)
    {
        discard;
    }

    const int2 nearest = clamp(int2(floor(glyph * glyphScale)), int2(0, 0), size - 1);
    const uint index = Table(input.op.z, Byte(Fetch(sourceTex, sourceSampler, nearest).r));

    if (index == 255u)
    {
        discard;
    }

    return Blended(float4(Shown(index) * coverage, coverage));
}

// Whether a texel the draw reads, of state `state` and value `value`, is drawn: a run of the key colour (SkipRunKey)
// and the colour key aren't; `value` becomes the colour table's (TableBefore), whose key isn't drawn either
// (SkipKeyAfterTable).
bool KeyedAndMapped(Input input, uint state, inout uint value)
{
    const uint flags = input.op.x;

    if (((flags & SkipRunKey) != 0 && state == 3 && value == 255) ||
        ((flags & ColorKey) != 0 && value == ((input.op.y >> 8) & 255u)))
    {
        return false;
    }

    if ((flags & TableBefore) != 0)
    {
        value = Table(input.op.z, value);
    }

    return (flags & SkipKeyAfterTable) == 0 || value != 255;
}

// Half a smooth line's or outline's width, in window pixels (the original's are a window pixel wide).
static const float LineHalfWidth = 0.5;

// Port-only: a line's or an ellipse's colour at drawn pixel `target`, the shape drawn at the output's resolution (its
// indices were written by the original's pixels, in an index-only pass): the drawn pixel's distance from the line
// between the centres of its first and last pixels (span), or from the ellipse (span: its centre and radii; walk.x 1
// when it is filled), its edge ramped over a drawn pixel. Premultiplied, through the blend pipeline.
Output SmoothShapePixel(Input input, int2 target, uint kind)
{
    const float2 window = (float2(target) + 0.5) * float2(scale.xy) / float2(scale.zw);
    const float ramp = max((float)scale.x / (float)scale.z, (float)scale.y / (float)scale.w);
    float distance;

    if (kind == KindSmoothLine)
    {
        const float2 a = float2(input.span.xy) + 0.5;
        const float2 ab = float2(input.span.zw) + 0.5 - a;
        const float length2 = dot(ab, ab);
        const float t = length2 > 0.0 ? saturate(dot(window - a, ab) / length2) : 0.0;
        distance = length(window - (a + t * ab)) - LineHalfWidth;
    }
    else
    {
        // The implicit ellipse's value over its gradient's length: about the distance from it, negative inside.
        const float2 radii = max(float2(input.span.zw), LineHalfWidth);
        const float2 p = (window - (float2(input.span.xy) + 0.5)) / radii;
        const float2 gradient = 2.0 * p / radii;
        const float signedDistance = (dot(p, p) - 1.0) / max(length(gradient), 1e-4);
        distance = input.walk.x != 0 ? signedDistance : abs(signedDistance) - LineHalfWidth;
    }

    const float coverage = saturate(0.5 - distance / ramp);

    if (coverage <= 0.0)
    {
        discard;
    }

    return Blended(float4(Shown(input.op.y & 255u), 1.0) * coverage);
}

// A smooth polygon's corner `i` (window pixels; source holds x in the low 16 bits, y in the high, signed).
float2 PolygonCorner(Input input, uint i)
{
    const int packed = input.source[i];
    return float2((float)((packed << 16) >> 16), (float)(packed >> 16));
}

// A smooth polygon's colour index at window point `window`, as the original's walk steps it: each side's from its top
// corner's to its bottom's (span holds the corners' indices), then along the row from the left side's to the right's.
float PolygonIndex(Input input, float2 window, uint corners)
{
    const float4 values = asfloat(input.span);
    float top = 1e9;
    float bottom = -1e9;

    for (uint i = 0; i < 4; i++)
    {
        if (i >= corners)
        {
            break;
        }

        top = min(top, PolygonCorner(input, i).y);
        bottom = max(bottom, PolygonCorner(input, i).y);
    }

    // Corners and spans are at the pixels' centres.
    const float2 at = float2(window.x - 0.5, clamp(window.y - 0.5, top, bottom));
    float2 left = float2(1e9, 0.0);
    float2 right = float2(-1e9, 0.0);

    for (uint j = 0; j < 4; j++)
    {
        if (j >= corners)
        {
            break;
        }

        const uint k = (j + 1) % corners;
        const float2 a = PolygonCorner(input, j);
        const float2 b = PolygonCorner(input, k);

        // A level side's ends are its neighbours' ends too.
        if (a.y == b.y)
        {
            continue;
        }

        const float t = (at.y - a.y) / (b.y - a.y);

        if (t < 0.0 || t > 1.0)
        {
            continue;
        }

        const float va = dot(values, float4(j == 0, j == 1, j == 2, j == 3));
        const float vb = dot(values, float4(k == 0, k == 1, k == 2, k == 3));
        const float2 side = float2(lerp(a.x, b.x, t), lerp(va, vb, t));
        left = side.x < left.x ? side : left;
        right = side.x > right.x ? side : right;
    }

    const float across = right.x > left.x ? saturate((at.x - left.x) / (right.x - left.x)) : 0.0;
    return lerp(left.y, right.y, across);
}

// Port-only: a flat or Gouraud polygon's colour at drawn pixel `target` (KindSmoothPolygon; its indices were written by
// the original's spans, index-only): inside its corners' edges (through the pixels' centres, half a window pixel out, as
// the spans take both ends), the edge ramped over a drawn pixel; its colour index stepped as the walk's (PolygonIndex),
// wrapping as the walk's. Premultiplied, through the blend pipeline.
Output SmoothPolygonPixel(Input input, int2 target)
{
    const float2 window = (float2(target) + 0.5) * float2(scale.xy) / float2(scale.zw);
    const float ramp = max((float)scale.x / (float)scale.z, (float)scale.y / (float)scale.w);
    const uint corners = input.walk.x;
    const float turn = (float)asint(input.walk.y);
    float inside = 1e9;

    for (uint i = 0; i < 4; i++)
    {
        if (i >= corners)
        {
            break;
        }

        const float2 a = PolygonCorner(input, i) + 0.5;
        const float2 b = PolygonCorner(input, (i + 1) % corners) + 0.5;
        const float2 edge = b - a;
        const float along = max(length(edge), 1e-4);
        inside = min(inside, turn * (edge.x * (window.y - a.y) - edge.y * (window.x - a.x)) / along);
    }

    const float coverage = saturate((inside + LineHalfWidth) / ramp + 0.5);

    if (coverage <= 0.0)
    {
        discard;
    }

    const uint index = (uint)(int)floor(PolygonIndex(input, window, corners)) & 255u;
    return Blended(float4(Shown(index), 1.0) * coverage);
}

Output main(Input input)
{
    // The drawn pixel, and the window pixel it shows.
    const int2 target = int2(floor(input.position.xy));
    const int2 pixel = WindowPixel(target, scale);

    if (any(pixel < input.rect.xy) || any(pixel > input.rect.zw))
    {
        discard;
    }

    const uint flags = input.op.x;
    const uint kind = flags & 15u;

    if (kind == KindHd)
    {
        return HdPixel(input, target);
    }

    if (kind == KindSharpGlyph)
    {
        return SharpGlyphPixel(input, target);
    }

    if (kind == KindSmoothLine || kind == KindSmoothEllipse)
    {
        return SmoothShapePixel(input, target, kind);
    }

    if (kind == KindHdMap)
    {
        return HdMapPixel(input, target);
    }

    if (kind == KindSmoothMap)
    {
        return SmoothMapPixel(input, target);
    }

    if (kind == KindSmoothPolygon)
    {
        return SmoothPolygonPixel(input, target);
    }

    const uint color = input.op.y & 255u;
    uint value = color;
    uint state = 1;
    float coverage = 1.0;

    if (kind == KindHash)
    {
        // Every other pixel; rows an odd distance above the bottom row start one pixel in (span: the left column and
        // the bottom row).
        const int odd = (input.span.y - pixel.y) & 1;
        const int column = pixel.x - input.span.x - odd;

        if (column < 0 || (column & 1) != 0)
        {
            discard;
        }
    }
    else if (kind == KindTexture)
    {
        const int2 texel = input.source.xy + (pixel - input.rect.xy) * input.source.zw;
        const float4 sample = FetchSource(texel);
        value = Byte(sample.r);
        state = (flags & OpaqueSource) != 0 ? 1 : Byte(sample.g);

        if ((flags & SmoothEdges) != 0)
        {
            coverage = ShapeCoverage(input, target, value);
            state = coverage > 0.0 ? 1 : 0;
        }
    }
    else if (kind == KindGouraud)
    {
        // The colour (16.16, wrapping) stepped once a pixel from the span's first column (source.x).
        const uint j = (uint)(pixel.x - input.source.x);
        value = (((uint)input.span.x + j * (uint)input.span.y) >> 16) & 255u;
    }
    else if (kind == KindTexelWalk)
    {
        // The texture offset after j steps: the step each pixel, plus what each carry of the u and v fractions adds.
        // The source is the texture as rows of source.z texels, source.w of them; texels outside it draw nothing.
        const uint j = (uint)(pixel.x - input.source.x);
        const int carriesU = (int)((input.walk.x + j * input.walk.y) >> 16);
        const int carriesV = (int)((input.walk.z + j * input.walk.w) >> 16);
        const int offset =
            input.span.x + (int)j * input.span.y + carriesU * input.span.z + carriesV * input.span.w;

        if (offset < 0 || offset >= input.source.z * input.source.w)
        {
            discard;
        }

        value = Byte(FetchSource(int2(offset % input.source.z, offset / input.source.z)).r);
    }

    if (state == 0)
    {
        discard;
    }

    const uint original = value;

    if (state == 2)
    {
        // A shape's skipped pixel: the fills write colour 0, the rest leave it.
        if ((flags & FillSkipped) == 0)
        {
            discard;
        }

        return Opaque(0);
    }

    if ((flags & UseColor) != 0)
    {
        value = color;
    }

    if (!KeyedAndMapped(input, state, value))
    {
        discard;
    }

    if ((flags & HdColors) != 0 && (flags & UseColor) == 0 && !(cycle.z != 0 && value == 255))
    {
        return HdTerrainPixel(input, target, original, value);
    }

    // A smooth-edged opaque shape's colour pass (its indices were written by an index-only one).
    if ((flags & SmoothEdges) != 0 && (flags & (AlphaBlend | TableAfter)) == 0)
    {
        return Blended(float4(Shown(value), 1.0) * coverage);
    }

    if ((flags & (AlphaBlend | TableAfter)) == 0)
    {
        return Opaque(value);
    }

    // The translucent colour (premultiplied, over the pixel), or an opaque one.
    float4 blend = float4(0.0, 0.0, 0.0, 0.0);
    bool opaque = false;

    if ((flags & AlphaBlend) != 0)
    {
        const uint entry = (flags & GivenAlpha) != 0 ? input.op.w : value;
        const uint alphaKind = (uint)round(Fetch(alphaTex, alphaSampler, int2(entry, 0)).x);

        if (alphaKind == AlphaNothing && (flags & TableAfter) == 0)
        {
            discard;
        }

        opaque = alphaKind == AlphaOpaque;
        blend = Fetch(alphaTex, alphaSampler, int2(entry, 1));

        if (((flags & OpaqueOnly) != 0 && !opaque) || ((flags & BlendedOnly) != 0 && opaque))
        {
            discard;
        }
    }

    if ((flags & TableAfter) != 0)
    {
        // The table maps what lies under the draw: an opaque pixel's index, else the colour shown there.
        if (opaque)
        {
            value = Table(input.op.w, value);
        }
        else
        {
            const float4 fit = Fetch(fitTex, fitSampler, int2(0, input.op.w));
            blend = float4(blend.rgb * (1.0 - fit.a) + fit.rgb, 1.0 - (1.0 - blend.a) * (1.0 - fit.a));
        }
    }

    // Drawn through the blend pipeline, full coverage replaces the pixel's colour; a smooth edge's partial coverage
    // blends that colour in.
    if (opaque)
    {
        return coverage < 1.0 ? Blended(float4(Shown(value), 1.0) * coverage) : Opaque(value);
    }

    return Blended(blend * coverage);
}
