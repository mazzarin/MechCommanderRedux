// Port-only: the kept ground (MCVulkanRenderer's KeptGround), drawn with quad.vshader over the drawn pixels whose
// window pixels lie in the terrain's clip (MCVulkanRenderer's DrawnPixels). The kept ground is the terrain layer drawn
// over nothing (transparent): its colours (premultiplied; alpha 1 where the terrain's first pass drew, partly where
// only its seam pass reached), indices and (SPEC-pan-water.md) weights, the share of its colours that follows the
// colour cycle, and the entries they follow (channels.hlsli's kept ground). Port-only (SPEC-kept-wrap.md): its
// textures wrap at their edges, a drawn pixel's kept pixel lying `origin` on from it (Wrapped), so a pan moves the
// origin, not the pixels. Each pixel reads its own kept pixel, or, while a zoom eases (`scale`, MCVulkanRenderer's
// GroundScale), the kept place its centre shows: the colours between the kept pixels round it (KeptBetween), the
// indices, weights and entries the one it lies in.
// By mode:
// - Copy (opaque pipeline): the kept view's colours, indices and stands as they are (port-only, SPEC-kept-forest.md:
//   MCVulkanRenderer's KeptGround::View, the ground and overlays as a surface's pass leaves them, wrapping with the
//   kept ground), its stands in the entries' place, which the stands build copies, and no weights (a blank texture),
//   the glints it leaves nothing.
// - Clear (opaque pipeline): nothing (transparent, index 0, no weight), to draw a part of it again (in its pass, whose
//   glints and stands targets hold the weights and the entries).
// - Over (blend pipeline, indices left): the colours over the target's, as the terrain's draws over it leave them,
//   and the glints under them covered as the colours cover them. Port-only (SPEC-pan-water.md): the kept ground holds
//   the colour cycle at its own step (cycle.z), so where the kept index is a cycled entry its share takes that
//   entry's colour from then to now (cycle.y), as draw.pshader's Corrected scales it: a step of the cycle draws none of
//   it again.
// - Indices (index-only pipeline): the indices where the first pass drew, which wrote them.
// - Blank (opaque pipeline): a window's new pixels, palette entry 0's colour (`blank`), index 0, nothing standing.
// Over and Indices fill the ground's gaps (GapFill), so they cover all the target but the void past the map.
// Port-only (SPEC-kept-wrap.md): drawn into the kept view, a part of it in pieces split at its edges, the quad moved
// onto each (`moved`), taken back from the pixel's place.
//
// Bindings (SDL GPU, SPIR-V): fragment samplers in space2, fragment uniforms in space3.

#include "channels.hlsli"

Texture2D<float4> colorsTex : register(t0, space2);
SamplerState colorsSampler : register(s0, space2);
Texture2D<float4> indicesTex : register(t1, space2);
SamplerState indicesSampler : register(s1, space2);
// Port-only (SPEC-pan-water.md): the kept weights; the palette, 256 x 2 (draw.pshader's: row 0 as shown, row 1 the
// HD pack's colours).
Texture2D<float4> weightsTex : register(t2, space2);
SamplerState weightsSampler : register(s2, space2);
Texture2D<float4> paletteTex : register(t3, space2);
SamplerState paletteSampler : register(s3, space2);
// Port-only (SPEC-pan-water.md): the entries the kept weights follow (R8: an entry's index).
Texture2D<float4> slotsTex : register(t4, space2);
SamplerState slotsSampler : register(s4, space2);

cbuffer Ground : register(b0, space3)
{
    // xy (SPEC-kept-wrap.md): where drawn pixel (0, 0)'s kept pixel lies in the kept textures, each 0 up to their
    // size; z: the mode; w unused.
    int4 origin;
    // Port-only (a zoom easing): the kept place a drawn place shows, xy a drawn pixel across and down, zw the place
    // drawn place 0 shows; x 0 when the kept ground isn't scaled.
    float4 scale;
    // Port-only (SPEC-pan-water.md), for Over: the colour cycle (draw.pshader's): x the first index cycled, y the step
    // now and z the kept ground's (-1: none); w unused. Index x + i shows the colour of cycleSources[(i + step) & 7].
    int4 cycle;
    uint4 cycleSources[2];
    // Port-only (SPEC-kept-forest.md), for Blank: its colour (opaque).
    float4 blank;
    // Port-only (SPEC-kept-wrap.md): xy how far the quad is moved on the target (drawn pixels), onto a piece of the
    // kept view; zw unused.
    int4 moved;
};

static const int ModeCopy = 0;
static const int ModeClear = 1;
static const int ModeOver = 2;
static const int ModeIndices = 3;
static const int ModeBlank = 4;

// The ground's gaps: where the original's tiles' diamonds don't quite meet (a few pixels a screen, at fixed places on
// the map) only the seam pass reaches, partly. Under it there the nearest pixel the first pass drew shows, looked for
// GapReach drawn pixels along a row, a column or a diagonal: the target needn't hold last frame's ground for them
// (MCVulkanRenderer's surfaces starting blank under the kept ground).
static const int GapReach = 3;
static const uint GapWays = 8;
static const int2 GapSteps[GapWays] = {int2(1, 0),  int2(-1, 0), int2(0, 1),  int2(0, -1),
                                       int2(1, 1), int2(-1, 1), int2(1, -1), int2(-1, -1)};
// No pixel under a gap (GapFill).
static const int2 NoPixel = int2(-1, -1);

// Port-only: the stands build (DRAW_STANDS 1: ground_stands.pshader), for the passes on a surface whose frame folds a
// forest's index pass into its HD frame's draw, with the stands target (channels.hlsli): nothing stands on the kept
// ground, its marks in the indices' alpha.
#ifndef DRAW_STANDS
#define DRAW_STANDS 0
#endif

struct Output
{
    float4 color : SV_Target0;
    float4 index : SV_Target1;
#if DRAW_STANDS
    float stands : SV_Target2;
    float4 glint : SV_Target3;
#else
    // The glints on a surface's passes; port-only (SPEC-pan-water.md), the weights on the kept ground's (Clear).
    float4 glint : SV_Target2;
#endif
};

// Port-only (SPEC-kept-wrap.md): where kept pixel `kept` (a drawn pixel's, in a ground `size` big) lies in the kept
// textures: `origin` on, wrapped at their edges.
int2 Wrapped(int2 kept, int2 size)
{
    const int2 at = kept + origin.xy;
    return at - size * int2(at >= size);
}

// Where kept pixel `kept` lies in the kept textures (`size` big), as a texture coordinate.
float2 KeptPlace(int2 kept, int2 size)
{
    return (float2(Wrapped(kept, size)) + 0.5) / float2(size);
}

// Port-only (SPEC-kept-wrap.md): kept place `place` (kept pixels; a pixel's centre at .5) as a texture coordinate in
// the kept textures, held to the ground's own pixels as clamping to its edges would, and read past the textures' edges
// by the repeating sampler (MCVulkanRenderer's _Linear), so a bilinear tap mixes only pixels side by side in the view.
float2 KeptTap(float2 place, int2 size)
{
    return (clamp(place, 0.5, float2(size) - 0.5) + float2(origin.xy)) / float2(size);
}

// The kept colours and indices at kept pixel `kept` (in a ground `size` big).
void KeptAt(int2 kept, int2 size, out float4 color, out float4 index)
{
    const float2 at = KeptPlace(kept, size);
    color = colorsTex.SampleLevel(colorsSampler, at, 0);
    index = indicesTex.SampleLevel(indicesSampler, at, 0);
}

// Port-only (SPEC-pan-water.md): the kept weights at kept pixel `kept`, and the entry they follow.
float4 WeightsAt(int2 kept, int2 size)
{
    return weightsTex.SampleLevel(weightsSampler, KeptPlace(kept, size), 0);
}

float SlotAt(int2 kept, int2 size)
{
    return slotsTex.SampleLevel(slotsSampler, KeptPlace(kept, size), 0).r;
}

// Port-only (a zoom easing): the kept ground's coverage at kept place `place` (kept pixels; a pixel's centre at .5),
// bilinear.
float KeptCover(float2 place, int2 size)
{
    return colorsTex.SampleLevel(colorsSampler, KeptTap(place, size), 0).a;
}

// Port-only (a zoom easing): the kept colours at kept place `place`, as sharp as the kept ground: Catmull-Rom between
// the 4x4 kept pixels round it (bilinear blurs the HD ground's grain), from nine bilinear taps (each pair of middle
// pixels' weights as one tap between them). Its alpha is the bilinear one (KeptCover), and its colours (premultiplied)
// kept within it, so it rings neither past the ground's edges nor into its gaps.
float4 KeptBetween(float2 place, int2 size)
{
    const float2 centre = floor(place - 0.5) + 0.5;
    const float2 f = place - centre;
    const float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    const float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    const float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    const float2 w3 = f * f * (-0.5 + 0.5 * f);
    const float2 w12 = w1 + w2;
    const float2 at[3] = {KeptTap(centre - 1.0, size), KeptTap(centre + w2 / w12, size), KeptTap(centre + 2.0, size)};
    const float2 weights[3] = {w0, w12, w3};
    float3 sharp = float3(0.0, 0.0, 0.0);

    [unroll] for (int row = 0; row < 3; ++row)
    {
        [unroll] for (int column = 0; column < 3; ++column)
        {
            sharp += colorsTex.SampleLevel(colorsSampler, float2(at[column].x, at[row].y), 0).rgb *
                     (weights[column].x * weights[row].y);
        }
    }

    const float alpha = KeptCover(place, size);
    return float4(clamp(sharp, float3(0.0, 0.0, 0.0), alpha.xxx), alpha);
}

// `output` at a kept pixel `kept` in a gap of the ground: over the nearest pixel the first pass drew, if any; that
// pixel, or NoPixel.
int2 GapFill(inout Output output, int2 kept, int2 size)
{
    for (int reach = 1; reach <= GapReach; ++reach)
    {
        for (uint way = 0; way < GapWays; ++way)
        {
            float4 color;
            float4 index;
            const int2 under = clamp(kept + reach * GapSteps[way], int2(0, 0), size - 1);
            KeptAt(under, size, color, index);

            if (color.a >= 1.0)
            {
                output.color = float4(output.color.rgb + (1.0 - output.color.a) * color.rgb, 1.0);
                output.index = index;
                return under;
            }
        }
    }

    return NoPixel;
}

// Port-only (SPEC-pan-water.md): palette entry `index`'s texel in row `row`.
float4 PaletteTexelAt(uint index, uint row)
{
    uint width;
    uint height;
    paletteTex.GetDimensions(width, height);
    return paletteTex.SampleLevel(paletteSampler, (float2(index, row) + 0.5) / float2(width, height), 0);
}

// Port-only (SPEC-pan-water.md): palette entry `index`'s colour in row `row`.
float3 PaletteAt(uint index, uint row)
{
    return PaletteTexelAt(index, row).rgb;
}

// Port-only (SPEC-pan-water.md): what kept share `share` of cycled entry `index` shows at step `step`: draw.pshader's
// Corrected's scaling of the colour it was made from (channels.hlsli's kept ground), before the game's brightness and
// then brightened as Corrected brightens it, clipped as the target clips it.
float3 CycledPart(float3 share, uint index, int step)
{
    const uint source = (index - (uint)cycle.x + (uint)step) & 7u;
    const float4 now = PaletteTexelAt(cycleSources[source >> 2][source & 3u], BeforeRow);
    const float3 then = max(PaletteAt(index, MadeWithRow), MadeWithFloor);
    const float3 corrected = share * clamp(now.rgb / then, 0.0, MaxCorrection);
    return min(BrightenedThrough(paletteTex, paletteSampler, corrected, 1.0, Byte(now.a)), 1.0);
}

// Port-only (SPEC-pan-water.md): `output`'s colours at kept pixel `kept` (its coverage as kept `covered`; `under` the
// pixel a gap fill put under it, or NoPixel) at the cycle's step now, where they follow a cycled entry.
void StepCycle(inout Output output, int2 kept, int2 size, float covered, int2 under)
{
    const uint slot = Byte(SlotAt(under.x >= 0 ? under : kept, size));

    if (cycle.y < 0 || cycle.z < 0 || cycle.y == cycle.z || slot - (uint)cycle.x >= WaterColors)
    {
        return;
    }

    float3 share = WeightsAt(kept, size).rgb;

    if (under.x >= 0)
    {
        share += (1.0 - covered) * WeightsAt(under, size).rgb;
    }

    output.color.rgb = saturate(output.color.rgb + CycledPart(share, slot, cycle.y) - CycledPart(share, slot, cycle.z));
}

Output main(float4 position : SV_Position)
{
    // The drawn pixel (port-only, SPEC-kept-wrap.md: the quad's move taken back).
    const int2 target = int2(floor(position.xy)) - moved.xy;

    Output output;
    output.color = float4(0.0, 0.0, 0.0, 0.0);
    output.index = float4(0.0, 0.0, 0.0, 0.0);
#if DRAW_STANDS
    output.stands = NoStand;
#endif
    output.glint = float4(0.0, 0.0, 0.0, 0.0);

    const int mode = origin.z;

    if (mode == ModeClear)
    {
        return output;
    }

    if (mode == ModeBlank)
    {
        output.color = blank;
        return output;
    }

    uint width;
    uint height;
    colorsTex.GetDimensions(width, height);
    const int2 size = int2(width, height);
    int2 kept = clamp(target, int2(0, 0), size - 1);

    if (scale.x != 0.0)
    {
        const float2 place = (float2(target) + 0.5) * scale.xy + scale.zw;
        kept = clamp(int2(floor(place)), int2(0, 0), size - 1);

        // Indices writes no colours (its pipeline's mask), so it takes only the coverage, which says where it writes.
        [branch] if (mode == ModeIndices)
        {
            output.color = float4(0.0, 0.0, 0.0, KeptCover(place, size));
        }
        else
        {
            output.color = KeptBetween(place, size);
        }

        output.index = indicesTex.SampleLevel(indicesSampler, KeptPlace(kept, size), 0);
    }
    else
    {
        KeptAt(kept, size, output.color, output.index);
    }

    const float covered = output.color.a;
    int2 under = NoPixel;

    if (mode != ModeCopy && covered > 0.0 && covered < 1.0)
    {
        under = GapFill(output, kept, size);
    }

    if (mode == ModeOver)
    {
        StepCycle(output, kept, size, covered, under);
        output.glint = float4(0.0, 0.0, 0.0, output.color.a);
    }
    else if (mode == ModeCopy)
    {
        output.glint = WeightsAt(kept, size);
#if DRAW_STANDS
        output.stands = SlotAt(kept, size);
#endif
    }
    else if (mode == ModeIndices && output.color.a < 1.0)
    {
        discard;
    }

    return output;
}
