// Port-only (SPEC-menus.md): a remade menu's draw (ui.vshader's triangles): its picture's texel (premultiplied) times
// its vertices' colour (premultiplied), blended over the window (ONE, ONE_MINUS_SRC_ALPHA). An untextured draw samples
// a white texel.
//
// Bindings (SDL GPU, SPIR-V): fragment samplers in space2.

Texture2D<float4> picture : register(t0, space2);
SamplerState pictureSampler : register(s0, space2);

float4 main(float4 position : SV_Position, float2 uv : TEXCOORD0, float4 color : TEXCOORD1) : SV_Target0
{
    return picture.SampleLevel(pictureSampler, uv, 0) * color;
}
