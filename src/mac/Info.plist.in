<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's Info.plist; version.cmake fills in the version, the build and the oldest macOS. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>MechCommander Redux</string>
  <key>CFBundleExecutable</key>
  <string>MechCommander Redux</string>
  <key>CFBundleIconFile</key>
  <string>MCRedux</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.revenantbob.mechcommanderredux</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>MechCommander Redux</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@MC_BUNDLE_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@MC_BUNDLE_BUILD@</string>
  <!-- A game: macOS turns on Game Mode while it's full screen. -->
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.strategy-games</string>
  <key>LSMinimumSystemVersion</key>
  <string>@MC_MIN_MACOS@</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- The updater (Sparkle): the fork's feed, from its latest release; the game looks once a start itself, and
       installs only an update signed with this key's private half (generate_keys, the releaser's login Keychain). -->
  <key>SUFeedURL</key>
  <string>https://github.com/mazzarin/MechCommanderRedux/releases/latest/download/appcast.xml</string>
  <key>SUPublicEDKey</key>
  <string>uJU9bzHfuaVaOzO0OUxodWg8ExKCBxWjoVxYLyoWrqw=</string>
  <key>SUEnableAutomaticChecks</key>
  <false/>
  <!-- The reports' server (main/MCTelemetry.h): empty, the app sends no reports. -->
  <key>MCReportsURL</key>
  <string>@MC_REPORTS_URL@</string>
</dict>
</plist>
