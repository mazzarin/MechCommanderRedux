<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's Info.plist; version.cmake fills in the version and the oldest macOS. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>MechCommander Redux</string>
  <key>CFBundleExecutable</key>
  <string>MechCommander Redux</string>
  <key>CFBundleIconFile</key>
  <string>MCRedux</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.revenantbob.mechcommanderredux</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>MechCommander Redux</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@MC_BUNDLE_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@MC_BUNDLE_VERSION@</string>
  <!-- A game: macOS turns on Game Mode while it's full screen. -->
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.strategy-games</string>
  <key>LSMinimumSystemVersion</key>
  <string>@MC_MIN_MACOS@</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
