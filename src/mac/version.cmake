# Writes MCVersion.h as MechCommander.props's MCGenerateVersionHeader does on Windows. Personal build: the version is
# version.json's major.minor.patch and the build the branch's count of commits, the same on every platform ("0.2.1
# (518)"). The updaters (Sparkle, WinSparkle) install only a higher build, and the count rises with every commit;
# nbgv's build (upstream's) counts only the commits since version.json's version changed, so it starts over at each
# version and differs between branches. Without git (a source zip) the build is 0; a shallow clone counts short, so it
# warns. With PLIST, it also writes the app's Info.plist from PLIST_TEMPLATE. Files are only rewritten when they change,
# so unchanged builds stay incremental.
# cmake -DREPO_DIR=<repository> -DOUTPUT=<MCVersion.h> [-DPLIST_TEMPLATE=<Info.plist.in> -DPLIST=<Info.plist>
#       -DMIN_MACOS=<14.0>] -P version.cmake

set(release "0.0.0")
set(build 0)
set(commit "unknown")

if(EXISTS ${REPO_DIR}/version.json)
  file(READ ${REPO_DIR}/version.json version_json)
  string(JSON json_version ERROR_VARIABLE json_error GET "${version_json}" version)

  if(NOT json_error)
    string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" json_release ${json_version})

    if(NOT json_release STREQUAL "")
      set(release ${json_release})
    endif()
  endif()
endif()

find_program(GIT git)

if(GIT)
  execute_process(COMMAND ${GIT} rev-list --count HEAD WORKING_DIRECTORY ${REPO_DIR}
                  RESULT_VARIABLE counted OUTPUT_VARIABLE commits OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)

  if(counted EQUAL 0)
    set(build ${commits})
    execute_process(COMMAND ${GIT} rev-parse --short=8 HEAD WORKING_DIRECTORY ${REPO_DIR}
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND ${GIT} rev-parse --is-shallow-repository WORKING_DIRECTORY ${REPO_DIR}
                    OUTPUT_VARIABLE shallow OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)

    if(shallow STREQUAL "true")
      message(WARNING "A shallow clone: the build (${build}) counts only the commits fetched; fetch the whole history.")
    endif()
  endif()
endif()

if(build EQUAL 0)
  message(WARNING "Could not count the commits (needs git and a checkout); the build is 0.")
endif()

set(version "${release}.${build}")
set(shown "${release} (${build})")
string(REPLACE "." "," commas ${version})
set(header "// Generated by src/mac/version.cmake from version.json and the git history. Do not edit.
#pragma once
#define MC_VERSION \"${version}\"
#define MC_VERSION_COMMAS ${commas}
#define MC_VERSION_SEMVER \"${release}+${build}\"
#define MC_VERSION_COMMIT \"${commit}\"
// Port-only (personal): the version as the game, its reports and the updaters show it, and the build alone.
#define MC_VERSION_SHOWN \"${shown}\"
#define MC_VERSION_BUILD ${build}
")

if(EXISTS ${OUTPUT})
  file(READ ${OUTPUT} previous)
endif()

if(NOT previous STREQUAL header)
  file(WRITE ${OUTPUT} "${header}")
endif()

# The app's shown version is major.minor.patch, as macOS reads it, and its build the count (CFBundleVersion, which
# Sparkle compares).
if(PLIST)
  set(MC_BUNDLE_VERSION ${release})
  set(MC_BUNDLE_BUILD ${build})
  set(MC_MIN_MACOS ${MIN_MACOS})
  configure_file(${PLIST_TEMPLATE} ${PLIST} @ONLY)
  message(STATUS "MechCommander Redux.app ${MC_BUNDLE_VERSION} (build ${MC_BUNDLE_BUILD})")
endif()

message(STATUS "MechCommander Redux ${shown} (${commit})")
