<rml>
<head>
    <title>Campaign</title>
    <link type="text/rcss" href="look.rcss"/>
    <link type="text/rcss" href="campaign.rcss"/>
    <link type="text/rcss" href="deploy.rcss"/>
    <link type="text/rcss" href="logistics.rcss"/>
</head>
<!-- Port-only (SPEC-menus.md, stage 8): the campaign's screens under one bar (logistics/MCCampaignMenu): BRIEFING to read
     the mission (the map whole on the left; its title, objectives, fire support, orders and warnings on the right) and
     DEPLOY to choose the force (READY AREA's cards left, two a row; the drop's three groups right, the weight and BEGIN
     MISSION along its foot); PURCHASING (the INVENTORY left; the store; the details, BUY or SELL, the buy window) and
     the 'MECH BAY (the INVENTORY; the force; the lab): logistics/MCLogisticsTabs. -->
<body class="night" data-model="campaign" data-class-mp="mp" data-class-keyscarry="keysCarry">
    <div id="topbar" class="bar">
        <div class="stage16">
            <div class="content">
                <div class="row gap4 tabs-row">
                    <div class="button small" id="mainmenu" data-hint="Main menu">Main menu</div>
                    <div class="tabs row" id="tabs"><div class="tab now">Briefing</div><div class="tab">Purchasing</div><div class="tab">Mech bay</div><div class="tab">Deploy</div></div>
                    <div class="grow"></div>
                    <div class="status"><div class="eyebrow" data-if="rp != ''">RP</div><div class="money points figures" data-if="rp != ''"><span data-for="g : rpFigures" data-class-digit="g.digit">{{g.text}}</span></div><div class="vrule" data-if="rp != ''"></div><div class="money figures"><span data-for="g : clockFigures" data-class-digit="g.digit">{{g.text}}</span></div></div>
                </div>
                <div class="players" data-if="mp">
                    <div class="team" data-if="ours.size > 0"><div class="team-name">Your team</div><div class="player" data-for="p : ours"><div class="light" data-class-ready="p.ready"></div><span data-attr-class="p.colour">{{p.name}}</span></div></div>
                    <div class="team" data-if="theirs.size > 0"><div class="team-name">Enemy</div><div class="player" data-for="p : theirs"><div class="light" data-class-ready="p.ready"></div><span data-attr-class="p.colour">{{p.name}}</span></div></div>
                    <div class="grow"></div>
                    <div class="count"><span class="cream">{{readyCount}}</span> of {{playerCount}} ready</div>
                </div>
            </div>
        </div>
    </div>

    <div class="stage16">
        <div id="page" class="content">
            <div class="row" id="briefing" data-if="tab == 0">
                <div id="map" class="map picture"><div class="zone-tag" data-for="z : zones" data-style-left="z.left" data-style-top="z.top" data-style-width="z.width" data-style-height="z.height" data-style-decorator="z.picture"></div></div>
                <div id="orders">
                    <div class="eyebrow" data-if="eyebrow != ''">{{eyebrow}}</div>
                    <div class="title caps">{{title}}</div>
                    <div class="scroll-box grow">
                        <div class="scroller reading" id="orders-text">
                            <div class="split">
                                <div>
                                    <div class="row bottom section objectives-head" data-if="objectives.size > 0"><div class="eyebrow grow">Objectives</div><div class="data grey caps time-limit" id="time-limit" data-if="timeLimit != ''">Mission time limit <span class="white">{{timeLimit}}</span></div></div>
                                    <div class="objective row top" data-for="line : objectives"><div class="num">{{line.num}}</div><div class="grow">{{line.text}}</div><div class="data grey caps time-limit" data-if="line.limit != ''">Time limit <span class="white">{{line.limit}}</span></div></div>
                                    <div class="row top section" data-if="fire.size > 0">
                                        <div class="eyebrow fire-label">Fire support</div>
                                        <div class="fire-lines"><div class="data grey caps" data-for="line : fire">{{line.text}}</div></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="eyebrow section" data-if="orders.size > 0">Orders</div>
                                    <p class="text grey para" data-for="line : orders">{{line.text}}</p>
                                    <div class="eyebrow section" data-if="warnings.size > 0">{{warningsHead}}</div>
                                    <p class="text grey para" data-for="line : warnings">{{line.text}}</p>
                                </div>
                            </div>
                        </div>
                        <div class="fade"></div>
                    </div>
                    <div class="row video-row" data-if="video">
                        <div class="data grey caps nowrap video-label">Operation briefing video</div>
                        <div class="button small" id="play" data-hint="Play">Play</div>
                        <div class="grow"></div>
                    </div>
                    <div id="brief-foot" data-if="mp"><div class="chat foot"><div class="chat-lines"><div class="chat-line" data-for="line : chat" data-class-game="line.game" data-class-team="line.team"><span data-if="!line.game" data-attr-class="'name ' + line.colour">{{line.name}}</span><span class="to" data-if="line.team"> to team</span><span data-if="!line.game">: </span>{{line.text}}</div></div><div class="chat-say"><div class="switch small" id="to-brief" data-hint="Who reads it"><div class="on">Team</div><div>All</div></div><input type="text" class="field" id="say-brief" maxlength="255" data-line="" data-value="say"/></div></div></div>
                </div>
                <div class="side-place" data-if="mp"><div class="chat side"><div class="row bottom head"><div class="heading caps grow">Chat</div></div><div class="chat-lines"><div class="chat-line" data-for="line : chat" data-class-game="line.game" data-class-team="line.team"><span data-if="!line.game" data-attr-class="'name ' + line.colour">{{line.name}}</span><span class="to" data-if="line.team"> to team</span><span data-if="!line.game">: </span>{{line.text}}</div></div><div class="chat-say"><div class="switch small" id="to-brief-side" data-hint="Who reads it"><div class="on">Team</div><div>All</div></div><input type="text" class="field" id="say-brief-side" maxlength="255" data-line="" data-value="say"/></div></div></div>
            </div>

            <div class="row" id="deploy" data-if="tab == 3">
                <div id="ready">
                    <div class="row bottom head">
                        <div class="heading caps grow">Ready area</div>
                    </div>
                    <div class="scroll-box grow">
                        <div class="scroller">
                            <div class="ready-grid">
                                <div class="card-cell" data-for="c, i : ready"><div class="card unit" data-attr-id="'ready' + i"
                                     data-class-off="c.off" data-class-refuse="c.refuse"
                                     data-hint="Drag into a slot" data-hint-right="Into the first open slot" data-hint-group="Into that group">
                                    <div class="pics">
                                        <div class="gauges" data-visible="c.piloted">
                                            <div class="condition"><div data-attr-class="c.shade" data-style-width="c.condition + '%'"></div></div>
                                            <div class="health"><div class="pip" data-class-lost="c.health &lt; 1"></div><div class="pip" data-class-lost="c.health &lt; 2"></div><div class="pip" data-class-lost="c.health &lt; 3"></div><div class="pip" data-class-lost="c.health &lt; 4"></div><div class="pip" data-class-lost="c.health &lt; 5"></div><div class="pip" data-class-lost="c.health &lt; 6"></div></div>
                                        </div>
                                        <div class="imgs"><div class="pic" data-style-decorator="c.outline"></div><div class="pic" data-if="c.piloted" data-style-decorator="c.pilot"></div><div class="pic seat" data-if="c.unpiloted"></div></div>
                                    </div>
                                    <div class="facts"><div class="who">{{c.who}}</div><div class="what">{{c.what}}</div><div class="t" data-if="c.why == ''">{{c.tons}}</div><div class="t why-line" data-if="c.why != ''">{{c.why}}</div></div>
                                </div></div>
                            </div>
                        </div>
                        <div class="fade"></div>
                    </div>
                </div>

                <div id="drop">
                    <div class="row bottom head">
                        <div class="heading caps grow">Drop</div>
                    </div>
                    <div class="groups">
                        <div class="group" data-for="g : groups">
                            <div class="group-head"><div class="eyebrow" data-class-closed="g.closed">{{g.name}}</div><div class="tons" data-if="g.tons != ''">{{g.tons}}</div></div>
                            <div class="card" data-for="c : g.cards" data-attr-id="'slot' + c.slot"
                                 data-class-unit="c.kind == 0" data-class-empty="c.kind == 1" data-class-closed="c.kind == 2"
                                 data-class-target="c.target" data-class-refuse="c.refuse"
                                 data-attr-data-hint="c.kind == 0 ? 'Drag into a slot' : ''" data-attr-data-hint-right="c.kind == 0 ? 'Back to the ready area' : ''">
                                <div class="pics" data-if="c.kind == 0">
                                    <div class="gauges" data-visible="c.piloted">
                                        <div class="condition"><div data-attr-class="c.shade" data-style-width="c.condition + '%'"></div></div>
                                        <div class="health"><div class="pip" data-class-lost="c.health &lt; 1"></div><div class="pip" data-class-lost="c.health &lt; 2"></div><div class="pip" data-class-lost="c.health &lt; 3"></div><div class="pip" data-class-lost="c.health &lt; 4"></div><div class="pip" data-class-lost="c.health &lt; 5"></div><div class="pip" data-class-lost="c.health &lt; 6"></div></div>
                                    </div>
                                    <div class="imgs"><div class="pic" data-style-decorator="c.outline"></div><div class="pic" data-if="c.piloted" data-style-decorator="c.pilot"></div><div class="pic seat" data-if="c.unpiloted"></div></div>
                                </div>
                                <div class="facts" data-if="c.kind == 0"><div class="who">{{c.who}}</div><div class="what">{{c.what}}</div><div class="t">{{c.tons}}</div></div>
                            </div>
                        </div>
                    </div>
                    <div class="grow"></div>
                    <div id="deploy-foot">
                    <div class="foot-place" data-if="mp"><div class="chat foot"><div class="chat-lines"><div class="chat-line" data-for="line : chat" data-class-game="line.game" data-class-team="line.team"><span data-if="!line.game" data-attr-class="'name ' + line.colour">{{line.name}}</span><span class="to" data-if="line.team"> to team</span><span data-if="!line.game">: </span>{{line.text}}</div></div><div class="chat-say"><div class="switch small" id="to-deploy" data-hint="Who reads it"><div class="on">Team</div><div>All</div></div><input type="text" class="field" id="say-deploy" maxlength="255" data-line="" data-value="say"/></div></div></div>
                    <div id="weight">
                        <div class="weight-read">
                            <div class="weight-now" data-class-more="weightMore" data-class-over="weightOver">{{weightNow}}</div>
                            <div class="weight-of">{{weightOf}}</div>
                            <div class="grow"></div>
                            <div class="weight-free" data-class-over="weightOver">{{weightFree}}</div>
                        </div>
                        <div class="weight-row">
                            <div class="ramp gauge"><div class="seg" data-for="s : ramp" data-style-height="s.height" data-class-on="s.state == 1" data-class-more="s.state == 2" data-class-over="s.state == 3"></div></div>
                            <div class="button main" id="begin" data-class-dark="!canBegin" data-hint="Begin mission">Begin mission</div>
                        </div>
                    </div>
                    </div>
                    <div class="card-cell" data-for="c : carried"><div class="card unit dragged" data-class-refuse="c.refuse"
                         data-style-left="carriedLeft" data-style-top="carriedTop" data-hint="Drop into the slot">
                        <div class="pics">
                            <div class="gauges" data-visible="c.piloted">
                                <div class="condition"><div data-attr-class="c.shade" data-style-width="c.condition + '%'"></div></div>
                                <div class="health"><div class="pip" data-class-lost="c.health &lt; 1"></div><div class="pip" data-class-lost="c.health &lt; 2"></div><div class="pip" data-class-lost="c.health &lt; 3"></div><div class="pip" data-class-lost="c.health &lt; 4"></div><div class="pip" data-class-lost="c.health &lt; 5"></div><div class="pip" data-class-lost="c.health &lt; 6"></div></div>
                            </div>
                            <div class="imgs"><div class="pic" data-style-decorator="c.outline"></div><div class="pic" data-if="c.piloted" data-style-decorator="c.pilot"></div><div class="pic seat" data-if="c.unpiloted"></div></div>
                        </div>
                        <div class="facts"><div class="who">{{c.who}}</div><div class="what">{{c.what}}</div><div class="t">{{c.tons}}</div></div>
                        <div class="why" data-if="c.why != ''">{{c.why}}</div>
                    </div></div>
                </div>
                <div class="side-place" data-if="mp"><div class="chat side"><div class="row bottom head"><div class="heading caps grow">Chat</div></div><div class="chat-lines"><div class="chat-line" data-for="line : chat" data-class-game="line.game" data-class-team="line.team"><span data-if="!line.game" data-attr-class="'name ' + line.colour">{{line.name}}</span><span class="to" data-if="line.team"> to team</span><span data-if="!line.game">: </span>{{line.text}}</div></div><div class="chat-say"><div class="switch small" id="to-deploy-side" data-hint="Who reads it"><div class="on">Team</div><div>All</div></div><input type="text" class="field" id="say-deploy-side" maxlength="255" data-line="" data-value="say"/></div></div></div>
            </div>
            <div class="row cols" id="logistics" data-if="tab == 1 || tab == 2">
                <div id="inventory" class="side">
                    <div class="row bottom head">
                        <div class="heading caps grow">Inventory</div>
                        <div class="data grey caps nowrap">{{stockCount}}</div>
                    </div>
                    <div class="kinds"><div class="switch small" id="stock-kinds" data-hint="What the inventory shows"><div class="on">Mechs</div><div>MechWarriors</div><div>Components</div></div></div>
                    <div class="scroll-box grow">
                        <div class="scroller">
                            <div class="stack" data-if="stockKind == 0">
                                <div class="card-cell" data-for="c, i : stored"><div class="card unit" data-attr-id="'stored' + i" data-class-picked="c.picked" data-class-pilotless="c.unpiloted"
                                     data-attr-data-hint="tab == 1 ? 'Drag onto the store' : 'Drag onto the force'" data-attr-data-hint-right="tab == 1 ? 'Sell' : 'Into the force'">
                                    <div class="pics">
                                        <div class="gauges" data-visible="c.piloted || c.unpiloted">
                                            <div class="condition"><div data-attr-class="c.shade" data-style-width="c.condition + '%'"></div></div>
                                            <div class="health" data-visible="c.piloted"><div class="pip" data-class-lost="c.health &lt; 1"></div><div class="pip" data-class-lost="c.health &lt; 2"></div><div class="pip" data-class-lost="c.health &lt; 3"></div><div class="pip" data-class-lost="c.health &lt; 4"></div><div class="pip" data-class-lost="c.health &lt; 5"></div><div class="pip" data-class-lost="c.health &lt; 6"></div></div>
                                        </div>
                                        <div class="imgs"><div class="pic" data-style-decorator="c.outline"></div><div class="pic" data-if="c.piloted" data-style-decorator="c.pilot"></div><div class="pic seat" data-if="c.unpiloted"></div></div>
                                    </div>
                                    <div class="facts"><div class="who" data-class-long="c.long">{{c.who}}</div><div class="what">{{c.what}}</div><div class="t" data-if="c.why == ''">{{c.tons}}</div><div class="t why-line" data-if="c.why != ''">{{c.why}}</div></div>
                                </div></div>
                            </div>
                            <div class="stack" data-if="stockKind != 0">
                                <div class="card-cell" data-for="g, i : stock"><div class="card good" data-attr-id="'stock' + i" data-class-picked="g.picked" data-class-off="g.off" data-class-warrior="g.warrior"
                                     data-attr-data-hint="tab == 1 ? 'Drag onto the store' : (g.warrior ? 'Drag to board' : 'Drag into the payload')" data-attr-data-hint-right="tab == 1 ? 'Sell' : (g.warrior ? 'Board' : 'Fit')">
                                    <div class="pics" data-if="g.warrior">
                                        <div class="gauges"><div class="health"><div class="pip" data-class-lost="g.health &lt; 1"></div><div class="pip" data-class-lost="g.health &lt; 2"></div><div class="pip" data-class-lost="g.health &lt; 3"></div><div class="pip" data-class-lost="g.health &lt; 4"></div><div class="pip" data-class-lost="g.health &lt; 5"></div><div class="pip" data-class-lost="g.health &lt; 6"></div></div></div>
                                        <div class="pic picture" data-style-decorator="g.picture"></div>
                                    </div>
                                    <div class="pic picture" data-if="!g.warrior" data-class-part="g.part" data-style-decorator="g.picture"></div>
                                    <div class="facts"><div class="who" data-class-long="g.long">{{g.who}}</div><div class="what">{{g.what}}</div><div class="row-t" data-if="g.why == '' &amp;&amp; g.price != ''"><div class="cream">{{g.price}}</div><div class="grey note">{{g.note}}</div></div><div class="row-t" data-if="g.why != ''"><div>{{g.why}}</div></div></div>
                                </div></div>
                            </div>
                        </div>
                        <div class="fade"></div>
                    </div>
                </div>
                <div class="gap"></div>
                <div class="over-band">
                <div class="row cols">
                <div id="units" class="side" data-if="tab == 2">
                    <div class="row bottom head">
                        <div class="heading caps grow">Force</div>
                        <div class="data grey caps nowrap">{{forceCount}}</div>
                    </div>
                    <div class="scroll-box grow">
                        <div class="scroller">
                            <div class="grid">
                                <div class="card-cell" data-for="c, i : force"><div class="card unit" data-attr-id="'force' + i" data-class-picked="c.picked" data-class-pilotless="c.unpiloted"
                                     data-hint="Pick" data-hint-right="Into the inventory">
                                    <div class="pics">
                                        <div class="gauges" data-visible="c.piloted || c.unpiloted">
                                            <div class="condition"><div data-attr-class="c.shade" data-style-width="c.condition + '%'"></div></div>
                                            <div class="health" data-visible="c.piloted"><div class="pip" data-class-lost="c.health &lt; 1"></div><div class="pip" data-class-lost="c.health &lt; 2"></div><div class="pip" data-class-lost="c.health &lt; 3"></div><div class="pip" data-class-lost="c.health &lt; 4"></div><div class="pip" data-class-lost="c.health &lt; 5"></div><div class="pip" data-class-lost="c.health &lt; 6"></div></div>
                                        </div>
                                        <div class="imgs"><div class="pic" data-style-decorator="c.outline"></div><div class="pic" data-if="c.piloted" data-style-decorator="c.pilot"></div><div class="pic seat" data-if="c.unpiloted"></div></div>
                                    </div>
                                    <div class="facts"><div class="who" data-class-long="c.long">{{c.who}}</div><div class="what">{{c.what}}</div><div class="t" data-if="c.why == ''">{{c.tons}}</div><div class="t why-line" data-if="c.why != ''">{{c.why}}</div></div>
                                </div></div>
                            </div>
                        </div>
                        <div class="fade"></div>
                    </div>
                </div>
                <div id="store" class="side" data-if="tab == 1">
                    <div class="row bottom head">
                        <div class="heading caps grow">Store</div>
                        <div class="data grey caps nowrap">{{storeCount}}</div>
                    </div>
                    <div class="kinds"><div class="switch small" id="kinds" data-hint="What the store shows"><div class="on">Mechs</div><div>MechWarriors</div><div>Components</div><div>Vehicles</div></div></div>
                    <div class="scroll-box grow">
                        <div class="scroller">
                            <div class="grid">
                                <div class="card-cell" data-for="g, i : store"><div class="card good" data-attr-id="'store' + i" data-class-picked="g.picked" data-class-off="g.off"
                                     data-hint="Pick" data-hint-right="Buy">
                                    <div class="pic picture" data-class-part="g.part" data-style-decorator="g.picture"></div>
                                    <div class="facts"><div class="who" data-class-long="g.long">{{g.who}}</div><div class="what">{{g.what}}</div><div class="row-t" data-if="g.why == ''"><div class="cream">{{g.price}}</div><div class="grow"></div><div class="grey">{{g.note}}</div></div><div class="row-t" data-if="g.why != ''"><div>{{g.why}}</div></div></div>
                                </div></div>
                            </div>
                        </div>
                        <div class="fade"></div>
                    </div>
                </div>
                <div class="gap"></div>
                <div id="info" data-if="tab == 1">
                    <div class="row bottom head"><div class="heading caps grow">{{infoName}}</div><div class="data grey caps nowrap" data-if="infoWhat != ''">{{infoWhat}}</div></div>
                    <div class="row variant" data-if="variants &gt; 1"><div class="switch small" id="variants" data-hint="Variant"><div class="on" data-class-off="variantOff0">Armor</div><div data-class-off="variantOff1">Weapons</div><div data-class-off="variantOff2">Jump jets</div></div></div>
                    <div class="spec" data-if="infoShown">
                        <div class="schematic picture" data-style-decorator="infoPicture"></div>
                        <div class="stats"><div class="stat" data-for="s : stats"><div class="label">{{s.label}}</div><div class="value">{{s.value}}</div></div></div>
                    </div>
                    <div class="rating" data-if="rated">
                        <div class="eyebrow">Combat effectiveness</div>
                        <div class="meter"><div class="meter-fill" data-style-width="rating + '%'"></div></div>
                    </div>
                    <div class="eyebrow section" data-if="kit.size > 0">Payload</div>
                    <div class="kit-row" data-for="k : kit"><span class="n">{{k.count}}</span>{{k.name}}</div>
                    <p class="desc" data-if="description != ''">{{description}}</p>
                    <div class="grow"></div>
                    <div class="deal" data-if="infoShown">
                        <div class="cost">{{infoCost}}</div><div class="eyebrow" style="margin-left: 4dp; line-height: 16dp;">RP</div><div class="data grey caps nowrap in-store">{{infoNote}}</div><div class="grow"></div><div class="button main" id="deal" data-class-dark="!canDeal" data-attr-data-hint="dealWord">{{dealWord}}</div>
                    </div>
                </div>
                <div id="lab" class="lab" data-if="tab == 2">
                    <div class="row bottom head"><div class="heading caps grow">{{labName}}</div><div class="data grey caps nowrap">{{labWhat}}</div></div>
                    <div class="lab-body" data-if="labKind &gt; 0">
                        <div>
                            <div class="lab-top">
                                <div class="schematic picture" data-style-decorator="labPicture"></div>
                                <div class="repairs" data-if="labKind != 2">
                                    <div class="repair"><div class="repair-line"><div class="label">Armor</div><div>{{armorNow}}</div><div class="grow"></div><div class="cost">{{armorCost}}</div></div>
                                        <input type="range" class="slider" id="armor" min="234" max="295" step="1" data-value="armorKnob" data-hint="Repair" data-if="repairs"/>
                                        <div class="meter" data-if="!repairs"><div class="meter-fill" data-style-width="((armorKnob - 234) * 100 / 61) + '%'"></div></div></div>
                                    <div class="repair"><div class="repair-line"><div class="label">Structure</div><div>{{structureNow}}</div><div class="grow"></div><div class="cost">{{structureCost}}</div></div>
                                        <input type="range" class="slider" id="structure" min="234" max="295" step="1" data-value="structureKnob" data-hint="Repair" data-if="repairs"/>
                                        <div class="meter" data-if="!repairs"><div class="meter-fill" data-style-width="((structureKnob - 234) * 100 / 61) + '%'"></div></div></div>
                                    <div class="repair"><div class="repair-line"><div class="label">Engine</div><div>{{engineNow}}</div><div class="grow"></div><div class="cost">{{engineCost}}</div></div>
                                        <input type="range" class="slider" id="engine" min="0" max="3" step="1" data-value="engineKnob" data-hint="Repair" data-if="repairs"/>
                                        <div class="meter" data-if="!repairs"><div class="meter-fill" data-style-width="(engineKnob * 100 / 3) + '%'"></div></div></div>
                                </div>
                            </div>
                            <div class="pilot" id="pilot" data-if="hasPilot" data-hint-right="Out of the 'Mech">
                                <div class="pics"><div class="health"><div class="pip" data-class-lost="pilotHealth &lt; 1"></div><div class="pip" data-class-lost="pilotHealth &lt; 2"></div><div class="pip" data-class-lost="pilotHealth &lt; 3"></div><div class="pip" data-class-lost="pilotHealth &lt; 4"></div><div class="pip" data-class-lost="pilotHealth &lt; 5"></div><div class="pip" data-class-lost="pilotHealth &lt; 6"></div></div><div class="portrait picture" data-style-decorator="pilotPicture"></div></div>
                                <div class="name"><div class="text caps pilot-name">{{pilotName}}</div><div class="data grey caps">{{pilotRank}}</div></div>
                                <div class="skills"><div class="skill" data-for="s : skills"><div class="repair-line"><div class="label">{{s.label}}</div><div class="grow"></div><div>{{s.value}}</div></div><div class="meter"><div class="meter-fill" data-style-width="s.value + '%'"></div></div></div></div>
                            </div>
                            <div class="pilot seat-row" id="seat" data-if="seat"><div class="seat"></div><div class="name"><div class="data grey caps">No pilot</div></div></div>
                        </div>
                        <div class="payload" data-if="labKind != 2">
                            <div class="row bottom payload-head"><div class="eyebrow grow">Payload</div><div class="data caps nowrap"><span class="cream">{{payloadNow}}</span><span class="grey"> {{payloadOf}}</span></div></div>
                            <div class="ramp small gauge"><div class="seg" data-for="s : payloadRamp" data-style-height="s.height" data-class-on="s.state == 1" data-class-more="s.state == 2" data-class-over="s.state == 3"></div></div>
                            <div class="fit-cell" data-for="f, i : fits"><div class="fit-row" data-attr-id="'fit' + i" data-hint="Pick" data-hint-right="Take out"><div class="range">{{f.range}}</div><div class="grow">{{f.name}}</div><div class="t">{{f.tons}}</div><div class="state">{{f.state}}</div></div></div>
                            <div class="fit-row open" data-if="labKind == 1"><div class="range"></div><div class="grow free">{{free}}</div></div>
                        </div>
                    </div>
                    <div class="grow"></div>
                    <div class="lab-foot" data-if="repairs || labStored"><div class="grow"></div><div class="button" id="repair-all" data-if="repairs" data-class-dark="!canRepairAll" data-hint="Repair all">{{repairAllWord}}</div><div class="button" id="refit-all" data-if="repairs" data-class-dark="!canRefit" data-hint="Refit all">Refit all</div><div class="button" id="into-force" data-if="labStored" data-hint="Into the force">Into the force</div></div>
                </div>
                </div>
                <div class="chat band" data-if="mp"><div class="chat-lines"><div class="chat-line" data-for="line : chat" data-class-game="line.game" data-class-team="line.team"><span data-if="!line.game" data-attr-class="'name ' + line.colour">{{line.name}}</span><span class="to" data-if="line.team"> to team</span><span data-if="!line.game">: </span>{{line.text}}</div></div><div class="chat-say"><div class="switch small" id="to-logistics" data-hint="Who reads it"><div class="on">Team</div><div>All</div></div><input type="text" class="field" id="say-logistics" maxlength="255" data-line="" data-value="say"/></div></div>
                </div>
            </div>
        </div>
    </div>
    <div id="hintbar">
        <div class="stage16">
            <div class="content">
                <div class="hints row"><div class="mouse-hints grow"></div><div class="keys"></div></div>
            </div>
        </div>
    </div>
    <div class="card-cell" data-for="g : lifted"><div class="card good dragged lifted" data-style-left="liftedLeft" data-style-top="liftedTop">
        <div class="pic picture" data-class-part="g.part" data-style-decorator="g.picture"></div>
        <div class="facts"><div class="who" data-class-long="g.long">{{g.who}}</div><div class="what">{{g.what}}</div></div>
    </div></div>
    <div class="veil" data-if="dealOpen"></div>
    <div class="window-place" data-if="dealOpen">
        <div id="deal-window" class="panel">
            <div class="panel-name">{{dealTitle}}</div>
            <div class="deal-thing"><div class="pic picture" data-style-decorator="dealPicture"></div><div><div class="text deal-name-line">{{dealName}}</div><div class="data grey caps" data-if="dealWhat != ''">{{dealWhat}}</div></div></div>
            <div class="deal-row"><div class="deal-name grow">Each</div><div class="deal-value">{{dealEach}}</div></div>
            <div class="deal-row"><div class="deal-name grow">How many</div><div class="stepper" id="deal-count" data-choices="1" data-choice="0" data-hint="How many"><div class="arrow">&lt;</div><div class="step-value"></div><div class="arrow">&gt;</div></div></div>
            <div class="deal-row"><div class="deal-name grow">Total</div><div class="deal-value">{{dealTotal}}</div></div>
            <div class="deal-row"><div class="deal-name grow">RP left</div><div class="deal-value">{{dealLeft}}</div></div>
            <div class="deal-foot"><div class="grow"></div><div class="button" id="deal-cancel" data-hint="Cancel">Cancel</div><div class="button main" id="deal-confirm" data-attr-data-hint="dealTitle">{{dealTitle}}</div></div>
        </div>
    </div>
</body>
</rml>
