/* Port-only (SPEC-menus.md, "Dialogs"): the game's copy of tools/menus-frames/frames/dialog.rcss. A dialog: a panel in
   the middle of the window over the screen it asks about, behind the veil; the question as its title, what it means
   under it, the way back at the left and the answer at the right. */
.dialog { width: 320dp; display: flex; flex-direction: column; }
.dialog > * { flex: 0 0 auto; }
.dialog .say { font-size: 11.63dp; line-height: 16dp; color: #dce4e4; white-space: normal; }
.dialog .say p { margin-bottom: 6dp; }
.dialog .foot { margin-top: 10dp; padding-top: 8dp; border-top: 1dp #2a3742; gap: 8dp; }
.dialog .foot > * { flex: 0 0 auto; }
.dialog .foot > .grow { flex: 1 1 0; }
