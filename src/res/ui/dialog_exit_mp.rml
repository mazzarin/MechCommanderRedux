<rml>
<head>
    <title>Exit multiplayer</title>
    <link type="text/rcss" href="look.rcss"/>
    <link type="text/rcss" href="dialog.rcss"/>
</head>
<!-- Port-only (SPEC-menus.md, "Dialogs"; the style frames' dialog_exit_mp.rml): the original's question before a
     player leaves a match, named by the game; it opens on CANCEL. -->
<body class="window-body">
    <div class="veil"></div>
    <div class="window-place">
        <div class="dialog panel glass">
            <div class="titlebar"><div class="eyebrow" id="game"></div><div class="heading caps">Exit multiplayer?</div></div>
            <div class="foot row"><div class="button" id="cancel" data-first>Cancel</div><div class="grow"></div><div class="button main" id="exit">Exit</div></div>
        </div>
    </div>
</body>
</rml>
