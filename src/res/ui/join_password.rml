<rml>
<head>
    <title>Password</title>
    <link type="text/rcss" href="look.rcss"/>
    <link type="text/rcss" href="dialog.rcss"/>
    <link type="text/rcss" href="host.rcss"/>
</head>
<!-- Port-only (SPEC-mco-rooms.md): JOIN GAME on a locked room in INTERNET's list (MechCommander Online's), a window over
     the list in HOST GAME's shape: the room's name over PASSWORD, CANCEL and JOIN GAME. -->
<body class="window-body">
    <div class="veil"></div>
    <div class="window-place">
        <div id="passwin" class="dialog panel glass">
            <div class="titlebar row bottom"><div class="grow"><div class="eyebrow" id="room"></div><div class="title caps">Join game</div></div></div>
            <div class="set-row">
                <div class="set-words"><div class="set-name">Password</div></div>
                <div class="set-control"><input type="password" class="field" id="password" maxlength="64" data-first/></div>
            </div>
            <div class="foot row">
                <div class="button" id="cancel" data-hint="Cancel">Cancel</div>
                <div class="grow"></div>
                <div class="button main" id="join" data-hint="Join">Join game</div>
            </div>
            <div class="hints row"><div class="mouse-hints grow"></div><div class="keys"></div></div>
        </div>
    </div>
</body>
</rml>
