<rml>
<head>
    <title>Loading</title>
    <link type="text/rcss" href="look.rcss"/>
    <link type="text/rcss" href="loading.rcss"/>
</head>
<!-- Port-only (SPEC-menus.md, "Into a mission and back"; stage 8): the loading screen after BEGIN MISSION
     (logistics/MCLoadingMenu): the mission's name, its objectives and the orders' first lines, its map, the load's
     progress along the foot; nothing to press. In a match the players under the map, each lit once in. -->
<body class="painting" data-model="loading">
    <div class="stage16">
        <div id="frame" class="content">
            <div id="loading" class="panel glass">
                <div class="titlebar row bottom"><div class="grow"><div class="eyebrow" data-if="eyebrow != ''">{{eyebrow}}</div><div class="title caps">{{title}}</div></div></div>
                <div class="load-body">
                    <div class="load-words">
                        <div class="row bottom objectives-head" data-if="objectives.size > 0"><div class="eyebrow grow">Objectives</div><div class="data grey caps time-limit" data-if="timeLimit != ''">Mission time limit <span class="white">{{timeLimit}}</span></div></div>
                        <div class="obj-line" data-for="line : objectives"><div class="n">{{line.num}}</div><div class="grow">{{line.text}}</div><div class="data grey caps time-limit" data-if="line.limit != ''">Time limit <span class="white">{{line.limit}}</span></div></div>
                        <div class="orders"><p data-for="line : orders">{{line.text}}</p></div>
                    </div>
                    <div class="load-side">
                        <div id="load-map" class="load-map picture" data-style-decorator="map"></div>
                        <div class="list-head row" data-if="match"><div class="cell grow first">Players</div><div class="cell" data-if="count != ''">{{count}}</div></div>
                        <div class="load-row" data-for="who : players"><div class="light" data-class-ready="who.in"></div><div class="who grow" data-attr-class="'who grow ' + who.colour">{{who.name}}</div><div class="pc" data-class-grey="!who.in">{{who.word}}</div></div>
                    </div>
                </div>
                <div id="progress"><div class="what">{{what}}</div><div class="meter"><div class="meter-fill cream" data-style-width="percent + '%'"></div></div><div class="pc">{{percent}}%</div></div>
            </div>
        </div>
    </div>
</body>
</rml>
