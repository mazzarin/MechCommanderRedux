/* Port-only (SPEC-menus.md, stage 8): the game's copy of tools/menus-frames/frames/logistics.rcss, with the remade
   screens' own rules after it (logistics/MCLogisticsTabs). PURCHASING and the 'MECH BAY (with campaign.rcss: the bar,
   the ground, the cards, the chat). One document holds the four tabs, so every rule is scoped to these two tabs' own
   elements: #logistics, the lifted card and the buy window. The INVENTORY keeps the left side on PURCHASING and the
   'MECH BAY (A2, the user's, 26 Nov): what is beside it changes with the tab, never where it is. */

/* A list's switch under its column's name (PURCHASING's kinds under STORE, 1998's tabs MECHS, MECHWARRIORS,
   COMPONENTS, VEHICLES, choosing what both lists show; the INVENTORY's MECHS, MECHWARRIORS and COMPONENTS). */
#logistics .kinds { display: flex; flex-direction: row; margin-bottom: 8dp; }
#logistics .kinds > * { flex: 0 0 auto; }

/* The columns: the INVENTORY, the store (or the force) and the details (or the lab), 16 apart. */
#logistics.cols, #logistics .cols { flex: 1 1 0; display: flex; flex-direction: row; align-items: stretch; }
#logistics.cols > *, #logistics .cols > * { flex: 0 0 auto; }
#logistics .side { flex: 0 0 288dp; display: flex; flex-direction: column; }
#logistics .side > * { flex: 0 0 auto; }
#logistics .side > .scroller { flex: 1 1 0; }
#logistics.cols > .gap, #logistics .cols > .gap { flex: 0 0 16dp; }
#logistics .grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 4dp; }
#logistics .grid > .card { flex: 0 0 136dp; }
#logistics .stack { display: flex; flex-direction: column; gap: 4dp; }
#logistics .stack > * { flex: 0 0 auto; }

/* A thing as a card (PURCHASING's goods, the inventory's parts): its picture in a 24-unit column, then its name, what it
   is, and its price or count in cream. Picked by the player: card teal. Out of reach: campaign.rcss's .off. */
#logistics .card.good .pic, .card.lifted .pic { flex: 0 0 24dp; height: 38dp; }
#logistics .card.good .pic.part, .card.lifted .pic.part { height: 24dp; margin-top: 7dp; }
/* A thing's name in its own case (a unit's callsign is in capitals). */
#logistics .good .who, .card.lifted .who { text-transform: none; letter-spacing: 0.01em; }
#logistics .switch > .off { color: #6c7a88; }
#logistics .card .row-t { display: flex; flex-direction: row; font-size: 9.51dp; line-height: 12dp; font-weight: 600; letter-spacing: 0.02em; white-space: nowrap; }
#logistics .card .row-t > * { flex: 0 0 auto; }
#logistics .card .row-t > .grow { flex: 1 1 0; }

/* The details beside the lists: what is under the pointer, else what was picked. */
#logistics #info { flex: 1 1 0; display: flex; flex-direction: column; }
#logistics #info > * { flex: 0 0 auto; }
#logistics #info > .grow { flex: 1 1 0; }
#logistics .spec { display: flex; flex-direction: row; align-items: flex-start; }
#logistics .spec > * { flex: 0 0 auto; }
#logistics .spec > .stats { flex: 1 1 0; margin-left: 10dp; }
#logistics .schematic { width: 56dp; height: 87dp; }
#logistics .stat { display: flex; flex-direction: row; height: 14dp; font-size: 9.51dp; line-height: 14dp; white-space: nowrap; }
#logistics .stat > * { flex: 0 0 auto; }
#logistics .stat > .label { flex: 0 0 64dp; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #7cd4ec; }
#logistics .stat > .value { flex: 1 1 0; }
#logistics .blueprint { height: 92dp; margin-bottom: 8dp; }
/* In multiplayer the details stand on the chat: the blueprint shorter, so BUY stays above it. */
.mp #logistics .blueprint { height: 60dp; }
#logistics .section { margin-top: 10dp; }
#logistics .kit-row { font-size: 11.63dp; line-height: 15dp; white-space: nowrap; }
#logistics .kit-row .n { display: inline-block; width: 14dp; font-weight: 600; color: #fcfcb8; }
#logistics .desc { font-size: 9.51dp; line-height: 13dp; color: #a4b0bc; margin-top: 8dp; }
#logistics .rating { margin-top: 8dp; }
#logistics .rating .meter { margin-top: 3dp; }
/* The price and BUY at the details' foot, as DEPLOY's weight and BEGIN MISSION: the number left, the button right. */
#logistics .deal { padding-top: 8dp; border-top: 1dp #2a3742; display: flex; flex-direction: row; align-items: flex-end; }
#logistics .deal > * { flex: 0 0 auto; }
#logistics .deal > .grow { flex: 1 1 0; }
#logistics .deal .cost { font-size: 14.8dp; line-height: 18dp; font-weight: 600; letter-spacing: 0.02em; color: #fcfcb8; white-space: nowrap; }
#logistics .deal .in-store { margin-left: 10dp; }

/* The buy (or sell) window: 1998's purchase dialog (each, how many, what is left), over the screen. */
#deal-window { flex: 0 0 248dp; display: flex; flex-direction: column; }
#deal-window > * { flex: 0 0 auto; }
#deal-window .deal-thing { display: flex; flex-direction: row; align-items: center; margin-bottom: 8dp; }
#deal-window .deal-thing > * { flex: 0 0 auto; }
#deal-window .deal-thing > .pic { width: 30dp; height: 30dp; margin-right: 10dp; }
#deal-window .deal-row { display: flex; flex-direction: row; align-items: center; height: 24dp; border-bottom: 1dp #141e26; }
#deal-window .deal-row > * { flex: 0 0 auto; }
#deal-window .deal-row > .grow { flex: 1 1 0; }
#deal-window .deal-name { font-size: 9.51dp; line-height: 12dp; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #7cd4ec; white-space: nowrap; }
#deal-window .deal-value { font-size: 11.63dp; line-height: 15dp; font-weight: 600; letter-spacing: 0.02em; color: #fcfcb8; white-space: nowrap; }
#deal-window .deal-row .step-value { width: 40dp; font-size: 11.63dp; color: #fcfcb8; }
#deal-window .deal-foot { display: flex; flex-direction: row; align-items: center; gap: 8dp; margin-top: 12dp; }
#deal-window .deal-foot > * { flex: 0 0 auto; }
#deal-window .deal-foot > .grow { flex: 1 1 0; }

/* The 'MECH BAY's lab, the picked mech: its schematic coloured for damage beside its repairs, its pilot, its payload. */
#logistics #lab { flex: 1 1 0; display: flex; flex-direction: column; }
#logistics #lab > * { flex: 0 0 auto; }
#logistics #lab > .grow { flex: 1 1 0; }
#logistics .lab-body { display: flex; flex-direction: column; }
#logistics .lab-body > * { flex: 0 0 auto; }
#logistics .lab-top { display: flex; flex-direction: row; align-items: flex-start; }
#logistics .lab-top > * { flex: 0 0 auto; }
#logistics .lab-top > .repairs { flex: 1 1 0; margin-left: 12dp; }
#logistics .lab .schematic { width: 66dp; height: 102dp; }
#logistics .repair { margin-bottom: 8dp; }
#logistics .repair-line { display: flex; flex-direction: row; font-size: 9.51dp; line-height: 13dp; white-space: nowrap; margin-bottom: 3dp; }
#logistics .repair-line > * { flex: 0 0 auto; }
#logistics .repair-line > .grow { flex: 1 1 0; }
#logistics .repair-line .label { font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #7cd4ec; margin-right: 8dp; }
#logistics .repair-line .cost { font-weight: 600; color: #fcfcb8; }
#logistics .pilot { display: flex; flex-direction: row; align-items: flex-start; margin-top: 12dp; padding-top: 8dp; border-top: 1dp #2a3742; }
#logistics .pilot > * { flex: 0 0 auto; }
#logistics .pilot > .skills { flex: 1 1 0; margin-left: 12dp; }
#logistics .pilot .pics { display: flex; flex-direction: column; }
#logistics .pilot .pics > * { flex: 0 0 auto; }
#logistics .pilot img { width: 24dp; height: 32dp; }
#logistics .pilot .health { display: flex; flex-direction: row; gap: 1dp; width: 24dp; height: 3dp; margin-bottom: 2dp; }
#logistics .pilot .pip { box-sizing: border-box; flex: 0 0 3dp; height: 3dp; background-color: #f26b55; }
#logistics .pilot .pip.lost { background-color: transparent; border: 1dp #6c7a88; }
#logistics .pilot .name { margin-left: 8dp; width: 64dp; }
#logistics .skills { display: flex; flex-direction: row; flex-wrap: wrap; gap: 4dp 12dp; }
#logistics .skill { flex: 0 0 76dp; }
#logistics .skill .repair-line { margin-bottom: 2dp; }
#logistics .payload { margin-top: 12dp; }
#logistics .payload .ramp { margin-bottom: 6dp; }
#logistics .fit-row { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; height: 18dp; padding: 0dp 4dp; border-bottom: 1dp #141e26; font-size: 11.63dp; line-height: 17dp; white-space: nowrap; }
#logistics .fit-row > * { flex: 0 0 auto; }
#logistics .fit-row > .grow { flex: 1 1 0; }
#logistics .fit-row.hover { background-color: #1b2c38; }
#logistics .fit-row .range { width: 52dp; font-size: 9.51dp; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #a4b0bc; }
#logistics .fit-row .t { width: 60dp; text-align: right; font-size: 9.51dp; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #fcfcb8; }
#logistics .fit-row .state { width: 60dp; text-align: right; font-size: 9.51dp; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #f26b55; }
/* The free row: an open place, sunk a step (DEPLOY's open slot), edged cyan while a part would drop into it. */
#logistics .fit-row.open { background-color: #0f171e; border-bottom-width: 0dp; margin-top: 4dp; }
#logistics .fit-row.open .free { font-size: 9.51dp; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #a4b0bc; }
#logistics .fit-row.target { border: 1dp #7cd4ec; }
#logistics .fit-row.coming { color: #7cd4ec; }
#logistics .fit-row.coming .t { color: #7cd4ec; }
#logistics .lab-foot { display: flex; flex-direction: row; align-items: center; gap: 10dp; margin-top: 10dp; }
#logistics .lab-foot > * { flex: 0 0 auto; }
#logistics .lab-foot > .grow { flex: 1 1 0; }
#logistics #inventory { flex: 0 0 204dp; }

/* A part being dragged from the inventory (campaign.rcss lifts it): the width of the INVENTORY's card at 16:10. */
.good.dragged { width: 168dp; }

/* Multiplayer: the middle and right columns stand on the chat (its newest two lines and the line being typed), so the
   INVENTORY keeps the whole left side, as on DEPLOY, where the chat sits under the groups. */
#logistics .over-band { flex: 1 1 0; display: flex; flex-direction: column; }
#logistics .over-band > * { flex: 0 0 auto; }
#logistics .over-band > .cols { flex: 1 1 0; }
#logistics .chat.band { flex: 0 0 auto; margin-top: 8dp; padding-top: 8dp; border-top: 1dp #2a3742; }
#logistics .chat.band .chat-lines { flex: 0 0 auto; }
/* The game's own: the band's newest two lines (two of the chat's 15-unit lines), older ones above them out of sight. */
#logistics .chat.band .chat-lines { height: 30dp; }

/* 16:10 and narrower: the lists a little narrower, the gaps 12. */
@media (max-aspect-ratio: 17/10) {
    #logistics .side { flex-basis: 268dp; }
    #logistics .grid > .card { flex-basis: 127dp; }
    #logistics.cols > .gap, #logistics .cols > .gap { flex-basis: 12dp; }
    #logistics #inventory { flex-basis: 160dp; }
}

/* 2:1 and wider (21:9): the lists three cards a row; the lab's payload a column beside its repairs and pilot. */
@media (min-aspect-ratio: 2/1) {
    #logistics .side { flex-basis: 426dp; }
    #logistics #inventory { flex-basis: 240dp; }
    #logistics .lab-body { flex-direction: row; }
    #logistics .lab-body > * { flex: 1 1 0; }
    #logistics .lab-body > .payload { margin-top: 0dp; margin-left: 24dp; }
}

/* The game's own: the lists scroll in their columns, a lifted card, the pilot's picture. */
#logistics .side > .scroll-box { flex: 1 1 0; }
#logistics .card .row-t .note { margin-left: 3dp; }
.good.dragged.lifted { width: 168dp; }
#logistics .pilot .portrait { width: 24dp; height: 32dp; }
#logistics .pilot-name { font-weight: 600; }
#deal-window .deal-name-line { font-weight: 600; }
#logistics .payload-head { margin-bottom: 4dp; }
#logistics .repair .slider { margin-top: 2dp; }
/* A button that can't act yet dark, as DEPLOY's BEGIN MISSION. */
#logistics .button.dark, #logistics .button.dark:hover, #logistics .button.dark:active { background-color: #1e2a34; border-color: #1e2a34; color: #a4b0bc; }
#logistics .fit-row { tab-index: auto; nav: auto; focus: auto; }
/* A fitted part's first column: a weapon's range, or Equipment (the INVENTORY cards' word) whole at every size. */
#logistics .fit-row .range { width: 62dp; }
#logistics .fit-row.open { tab-index: none; }
#logistics .pilot { tab-index: auto; nav: auto; focus: auto; }
/* The lists repeat a cell holding each card (campaign.rml's lists that change length). */
#logistics .grid > .card-cell { flex: 0 0 136dp; }
#logistics .stack > .card-cell { flex: 0 0 auto; }
@media (max-aspect-ratio: 17/10) {
    #logistics .grid > .card-cell { flex-basis: 127dp; }
}
/* A good's count and what it is (LEFT, OWNED) in the cards' capitals. */
#logistics .card .row-t > .grey, #logistics .card .row-t .note { text-transform: uppercase; letter-spacing: 0.06em; }
/* The lab's repairs: the sliders the repair line's width; its parts scroll under its repairs, its foot kept in view. */
#logistics .repair input.range.slider { width: 100%; }
#logistics #lab > .lab-body { flex: 1 1 0; overflow-y: auto; }
/* While its parts scroll, its rail 12 units clear of the bars and rows (the look's 4), as a panel's inside; with no rail
   they run the column's width. */
#logistics #lab > .lab-body scrollbarvertical { margin-left: 10dp; }
#logistics #lab > .grow { display: none; }
/* Port-only (the frames are 16:10 and wider): 4:3 and 5:4, a third narrower than 16:9, the lists one card a row (as
   DEPLOY's READY AREA), so the details and the lab keep their room. */
@media (max-aspect-ratio: 3/2) {
    #logistics .side { flex-basis: 148dp; }
    #logistics #inventory { flex-basis: 148dp; }
    #logistics.cols > .gap, #logistics .cols > .gap { flex-basis: 12dp; }
    #logistics .grid > .card-cell { flex-basis: 136dp; }
    /* The columns' switches (the store's kinds, the INVENTORY's) wrap onto a second row, sharing their borders (the
       padding holds the last segment's shared border on each row). */
    #logistics .side .switch { flex-wrap: wrap; padding: 0dp 1dp 1dp 0dp; }
    /* The INVENTORY's name alone (its count beside it would spill the column). */
    #logistics #inventory > .head > .data { display: none; }
    #logistics .side .switch > div { flex: 1 1 auto; text-align: center; margin-bottom: -1dp; }
}
/* Picked but out of reach (a sold-out good, a variant none are left of): its words lighter on the teal, still dim. */
#logistics .card.picked.off .who, #logistics .card.picked.off .what, #logistics .card.picked.off .t,
#logistics .card.picked.off .row-t, #logistics .switch > .on.off { color: #a4b0bc; }
#logistics .card.picked.off .vchip { border-color: #a4b0bc; color: #a4b0bc; }
/* A good's name longer than the frames' (LogisticsTabs' LongName) in the details' size, so it fits its card. */
#logistics .good .who.long, .card.lifted .who.long { font-size: 9.51dp; letter-spacing: 0; }
/* The INVENTORY's switch a little tighter than the kit's, so MECHS, MECHWARRIORS and COMPONENTS fit its 204 units at
   every 16:9 window (their letters set a little wider at some sizes, as 3600x2024's). */
#logistics #inventory .switch.small > div { padding: 0dp 5dp; }
/* 16:10 and narrower: the switches' segments and a good's card a little tighter, so the store's four kinds, the
   variants and a part's longest lines fit the narrower columns. */
@media (max-aspect-ratio: 17/10) {
    #logistics .switch.small > div, #logistics #inventory .switch.small > div { padding: 0dp 5dp; }
    #logistics .card.good { padding: 4dp 3dp; gap: 4dp; }
    #logistics .card.good .what { letter-spacing: 0; }
}
/* Port-only: 21:9 keeps the lab one column, as 16:9 (the frame's payload beside the repairs leaves a fitted part's name
   too little room beside its range, tons and state), the payload under the pilot; the pilot's four skills a row,
   sharing the lab's width (never three and one). */
@media (min-aspect-ratio: 2/1) {
    #logistics .lab-body { flex-direction: column; }
    #logistics .lab-body > * { flex: 0 0 auto; }
    #logistics .lab-body > .payload { margin-top: 12dp; margin-left: 0dp; }
    #logistics .skills { flex-wrap: nowrap; }
    #logistics .skill { flex: 1 1 0; }
}

/* ---- A2 (the user's, 26 Nov): the INVENTORY on the left, its MECHS the units stored outside the force ---- */

/* A 'Mech without a MechWarrior (the force's, the INVENTORY's): its name in its own case first, NO PILOT under it in
   the cards' capitals; its condition over its outline, the pilot's place an empty seat. */
#logistics .card.pilotless .who, #logistics .card.vehicle .who { text-transform: none; letter-spacing: 0.01em; }
#logistics .card.pilotless .what, #logistics .card.vehicle .what { text-transform: uppercase; letter-spacing: 0.04em; }
/* A name longer than a force card holds (LogisticsTabs' PilotlessNameLetters) in the details' size; at 16:10 and
   narrower every force card's, as its 127 units hold the details' size alone; the INVENTORY's long ones at 4:3. */
#logistics #units .card.pilotless .who.long, #logistics #units .card.vehicle .who.long { font-size: 9.51dp; letter-spacing: 0; }
@media (max-aspect-ratio: 17/10) {
    #logistics #units .card.pilotless .who, #logistics #units .card.vehicle .who { font-size: 9.51dp; letter-spacing: 0; }
}
@media (max-aspect-ratio: 3/2) {
    #logistics #inventory .card.pilotless .who.long, #logistics #inventory .card.vehicle .who.long { font-size: 9.51dp; letter-spacing: 0; }
}
/* A force card's name longer again (over MCCampaignScreen::SmallNameLetters: "AeroSpace Spotter") in Fine. */
#logistics #units .card.unit .who.long.longer { font-size: 8.75dp; }
/* A MechWarrior in no 'Mech: their health over their portrait, as on a unit's card; the callsign, the rank. */
#logistics .card.good.warrior .pics { flex: 0 0 24dp; }
#logistics .card.good.warrior .pics > .pic { flex: 0 0 32dp; width: 24dp; height: 32dp; }
/* The lab's 'Mech without a MechWarrior: the pilot's place an open seat, sunk a step, boxed. */
#logistics .pilot.seat-row { align-items: center; padding: 4dp; background-color: #0f171e; border: 1dp #1e2b36; tab-index: none; }
#logistics .pilot .seat { box-sizing: border-box; width: 24dp; height: 32dp; background-color: #0b1116; border: 1dp #2a3742; }
#logistics .pilot.seat-row .name { margin-left: 10dp; width: auto; }
/* 16:10: the INVENTORY's 160 units hold its switch on two rows, sharing their borders (as 4:3's). */
@media (max-aspect-ratio: 17/10) {
    #logistics #inventory .switch { flex-wrap: wrap; padding: 0dp 1dp 1dp 0dp; }
    #logistics #inventory .switch > div { flex: 1 1 auto; text-align: center; margin-bottom: -1dp; }
}

/* ---- The user's notes, 26 Nov ---- */

/* A column's switch wrapped onto a second row (16:10's INVENTORY, 4:3's columns): one frame round both rows, their right
   edges matched. Each segment's right border lies over the next one's or, at a row's end, in the switch's 1-unit
   padding: the last segment's too (look.rcss keeps a last segment's border inside, which left COMPONENTS a unit short
   of the row above it). */
@media (max-aspect-ratio: 17/10) {
    #logistics #inventory .switch > div:last-child { margin-right: -1dp; }
}
@media (max-aspect-ratio: 3/2) {
    #logistics .side .switch > div:last-child { margin-right: -1dp; }
}

/* REPAIR FORCE at the FORCE's foot (the user's, 26 Nov), as REPAIR ALL at the lab's: at the right, its price in its
   word; 4:3's one-card column holds it at the small buttons' size. */
#logistics .force-foot { display: flex; flex-direction: row; align-items: center; margin-top: 10dp; }
#logistics .force-foot > * { flex: 0 0 auto; }
#logistics .force-foot > .grow { flex: 1 1 0; }
@media (max-aspect-ratio: 3/2) {
    #logistics .force-foot > .button { height: 16dp; line-height: 14dp; padding: 0dp 8dp; font-size: 9.51dp; }
}

/* An owned 'Mech's damaged parts in PURCHASING's payload (the user's, 26 Nov): DAMAGED in red at the row's right, as
   the 'MECH BAY's rows. */
#logistics .kit-row .state { float: right; font-size: 9.51dp; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #f26b55; }

/* ---- The user's picks, 26 Nov (menu-overhaul/26nov-mocks, the A's) ---- */

/* Three near-equal columns (question 1, A): the INVENTORY 264, the force (or the store) 264, the details the rest
   (261) at 16:9; the force's and the store's cards two a row at 126 units, and the INVENTORY's MECHS too, as the
   force's. A good's padding and gap tighter; a 'Mech's name without a pilot (a vehicle's) at the details' size. */
#logistics #inventory { flex-basis: 264dp; }
#logistics #units, #logistics #store { flex-basis: 264dp; }
#logistics .grid > .card-cell { flex-basis: 126dp; }
#logistics .card.good { padding: 4dp 3dp; gap: 4dp; }
#logistics .card.good .what { letter-spacing: 0; }
#logistics .grid .card.pilotless .who, #logistics .grid .card.vehicle .who { font-size: 9.51dp; letter-spacing: 0; }
#logistics .grid .card.unit .who.long.longer { font-size: 8.75dp; }
/* 21:9: 284, 426 (three cards a row at 136) and the rest (373); a name without a pilot at the cards' size again. */
@media (min-aspect-ratio: 2/1) {
    #logistics #inventory { flex-basis: 284dp; }
    #logistics #units, #logistics #store { flex-basis: 426dp; }
    #logistics .grid > .card-cell { flex-basis: 136dp; }
    #logistics .card.good { padding: 4dp 5dp; gap: 6dp; }
    #logistics .grid .card.pilotless .who, #logistics .grid .card.vehicle .who { font-size: 11.63dp; letter-spacing: 0.01em; }
    #logistics .grid .card.pilotless .who.long, #logistics .grid .card.vehicle .who.long { font-size: 9.51dp; letter-spacing: 0; }
}
/* 16:10: 220, 268 (two cards a row at 127) and the rest (221); the INVENTORY's MECHS one a row. */
@media (max-aspect-ratio: 17/10) {
    #logistics #inventory { flex-basis: 220dp; }
    #logistics #units, #logistics #store { flex-basis: 268dp; }
    #logistics .grid > .card-cell { flex-basis: 127dp; }
    #logistics #inventory .grid.mechs > .card-cell { flex-basis: 100%; }
}
/* Port-only, 4:3 and 5:4: the INVENTORY 16:10's 220, so its switch keeps one row with Z and C; the force (or the
   store) one card a row (148); the details the rest (216, 16:10's arrangement). */
@media (max-aspect-ratio: 3/2) {
    #logistics #inventory { flex-basis: 220dp; }
    #logistics #units, #logistics #store { flex-basis: 148dp; }
    #logistics .grid > .card-cell { flex-basis: 136dp; }
    #logistics #inventory > .head > .data { display: block; }
}

/* A list's switch with Z and C at its ends (the user's keys for it): the switch spans the column between them, its
   segments sharing it, so a narrower column never wraps it; the store's four kinds set closer. */
#logistics .kinds { align-items: center; }
#logistics .kinds > .key { flex: 0 0 auto; height: 16dp; margin-right: 0dp; padding: 0dp 4dp; font-size: 9.51dp; line-height: 14dp; }
#logistics .kinds > .key.first { margin-right: 4dp; }
#logistics .kinds > .key.last { margin-left: 4dp; }
#logistics .kinds > .switch { flex: 1 1 auto; }
#logistics .kinds > .switch > div, #logistics #inventory .kinds > .switch.small > div { flex: 1 1 auto; text-align: center; padding: 0dp 4dp; }
#logistics .kinds > .switch.many > div { padding: 0dp 2dp; letter-spacing: 0.02em; }
/* 16:10, 4:3: the INVENTORY's switch kept on one row, its words set closer. */
@media (max-aspect-ratio: 17/10) {
    #logistics #inventory .switch { flex-wrap: nowrap; padding: 0dp; }
    #logistics #inventory .switch > div, #logistics #inventory .kinds > .switch.small > div { padding: 0dp 2dp; letter-spacing: 0.02em; margin-bottom: 0dp; }
    #logistics #inventory .switch > div:last-child { margin-right: 0dp; }
}

/* The details narrower: the pilot's face beside the callsign and rank on one line, the four skills two a row under
   them (one row at 21:9, as before). */
#logistics .pilot > .pbody { flex: 1 1 0; margin-left: 10dp; display: flex; flex-direction: column; }
#logistics .pilot > .pbody > * { flex: 0 0 auto; }
#logistics .pilot .pname { display: flex; flex-direction: row; align-items: flex-end; margin-bottom: 4dp; white-space: nowrap; }
#logistics .pilot .pname > * { flex: 0 0 auto; }
#logistics .pilot .pname > .data { margin-left: 8dp; line-height: 14dp; }
#logistics .pilot .skills { gap: 4dp 12dp; }
#logistics .pilot .skill { flex: 1 1 40%; }
@media (min-aspect-ratio: 2/1) {
    #logistics .pilot .skill { flex: 1 1 0; }
}
/* A fitted part's row: its range in Fine, its tons narrower, so its name keeps its room (ST SR Missile Pack, the
   longest); a damaged part says DAMAGED in red in its range's place. */
#logistics .fit-row .range { width: 50dp; font-size: 8.75dp; letter-spacing: 0.03em; }
#logistics .fit-row .range.damaged { color: #f26b55; }
#logistics .fit-row .t { width: 44dp; }
#logistics .fit-row > .grow { padding-right: 3dp; }
/* The foot's buttons tighter; where they don't fit one row (16:10) they wrap onto two, at the right. */
#logistics .lab-foot { flex-wrap: wrap; justify-content: flex-end; gap: 6dp 8dp; }
#logistics .lab-foot .button { padding: 0dp 10dp; }
/* The details' description keeps the pixel at its right a wrapped line may take (RmlUi rounds its room up), as the
   room's map text. */
#logistics .desc { padding-right: 1px; }

/* ---- The user's variants A (26 Nov mocks): the letter in a chip (campaign.rcss), pips, the VARIANT rows ---- */

/* A store 'Mech's variants: three pips under its picture, cream for one in store, an empty box for one none are left
   of, the one shown cyan. */
#logistics .card.good .pics.chassis { flex: 0 0 24dp; display: flex; flex-direction: column; }
#logistics .card.good .pics.chassis > * { flex: 0 0 auto; }
#logistics .card.good .pic.with-pips { height: 32dp; }
#logistics .vpips { display: flex; flex-direction: row; gap: 2dp; height: 4dp; margin-top: 2dp; padding-left: 2dp; }
#logistics .vpips > div { box-sizing: border-box; flex: 0 0 5dp; height: 4dp; background-color: #fcfcb8; }
#logistics .vpips > div.out { background-color: transparent; border: 1dp #6c7a88; }
#logistics .vpips > div.shown { background-color: #7cd4ec; }
/* The details' VARIANT (for 1998's variant buttons): a row a variant, the one shown teal; each its letter, its word,
   what it changes (its description's own sentence) and how many are left; one none are left of dim. A row takes the
   keys' focus as a list's; a click or Enter shows it. */
#logistics .vrows { display: flex; flex-direction: column; gap: 2dp; margin: 4dp 0dp 10dp 0dp; }
#logistics .vrows > * { flex: 0 0 auto; }
#logistics .vrow { display: flex; flex-direction: row; align-items: center; height: 18dp; padding: 0dp 4dp;
                   background-color: #142029; white-space: nowrap; tab-index: auto; nav: auto; focus: auto; }
#logistics .vrow > * { flex: 0 0 auto; }
#logistics .vrow > .grow { flex: 1 1 0; }
#logistics .vrow:hover { background-color: #1b2c38; }
#logistics .vrow.on { background-color: #045454; }
/* One chip width, so the words line up. */
#logistics .vrow .vchip { width: 12dp; text-align: center; padding: 0dp; margin-left: 0dp; margin-right: 6dp; }
#logistics .vrow .vword { width: 54dp; font-size: 9.51dp; line-height: 18dp; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
#logistics .vrow .vsays { font-size: 8.75dp; line-height: 18dp; color: #a4b0bc; }
#logistics .vrow.on .vsays { color: #c4ccd4; }
#logistics .vrow .vleft { font-size: 9.51dp; line-height: 18dp; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #a4b0bc; margin-left: 6dp; }
#logistics .vrow.on .vleft { color: #c4ccd4; }
#logistics .vrow.off .vword, #logistics .vrow.off .vsays, #logistics .vrow.off .vleft { color: #6c7a88; }
#logistics .vrow.off .vchip { border-color: #6c7a88; color: #6c7a88; }
/* The one shown with none left: dim on the teal in the picked card's grey (#6c7a88 reads 2:1 there, this 4:1). */
#logistics .vrow.on.off .vword, #logistics .vrow.on.off .vsays, #logistics .vrow.on.off .vleft { color: #a4b0bc; }
#logistics .vrow.on.off .vchip { border-color: #a4b0bc; color: #a4b0bc; }

/* ---- The user's MechWarrior skills A (26 Nov mocks): the INVENTORY's MechWarriors' four skills ---- */

/* A MechWarrior's card shows their four skills in its free room, two a row, as the lab's pilot box draws them; at 16:10
   and narrower (the INVENTORY one card wide at 220 units) under the face and the name, the card taller. */
#logistics .card.good.warrior.skilled .facts { flex: 0 0 62dp; }
#logistics .card.good.warrior.skilled .wskills { flex: 1 1 0; display: flex; flex-direction: row; flex-wrap: wrap; gap: 2dp 10dp; margin-top: 1dp; }
#logistics .wskills > .skill { flex: 1 1 40%; }
#logistics .wskills .repair-line { margin-bottom: 1dp; line-height: 12dp; }
#logistics .wskills .meter { height: 3dp; }
#logistics .card.picked .wskills .meter { background-color: #0b3a3a; }
#logistics .card.picked .wskills .meter-fill { background-color: #c4ccd4; }
@media (max-aspect-ratio: 17/10) {
    #logistics .card.good.warrior.skilled { height: auto; flex-wrap: wrap; }
    #logistics .card.good.warrior.skilled .facts { flex: 1 1 0; }
    #logistics .card.good.warrior.skilled .wskills { flex: 0 0 100%; margin-top: 2dp; }
}
