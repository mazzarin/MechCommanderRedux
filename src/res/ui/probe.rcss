/* Port-only (SPEC-menus.md): the probe's style, in the 1998 screens' pixels (dp). */

@spritesheet frame
{
    src: art:MFDSWN01;
    frame-tl: 0px 0px 5px 5px;
    frame-t: 40px 0px 32px 5px;
    frame-tr: 135px 0px 5px 5px;
    frame-l: 0px 40px 5px 40px;
    frame-c: 20px 40px 40px 40px;
    frame-r: 135px 40px 5px 40px;
    frame-bl: 0px 234px 5px 5px;
    frame-b: 40px 234px 32px 5px;
    frame-br: 135px 234px 5px 5px;
}

body
{
    width: 100%;
    height: 100%;
    background-color: #000;
    font-family: white10;
    font-size: 10dp;
    /* A game font's cell holds its letters and the space under them. */
    line-height: 1.0;
    color: #fff;
}

#frame
{
    position: absolute;
    left: 8dp;
    top: 8dp;
    right: 8dp;
    bottom: 8dp;
    padding: 10dp;
    /* The frame cut from MFDSWN01: its corners whole, its edges and centre repeated (our frame-box, ui/MCRmlFrame). */
    decorator: frame-box(frame-tl, frame-t, frame-tr, frame-l, frame-c, frame-r, frame-bl, frame-b, frame-br);
}

#title
{
    display: block;
    height: 12dp;
    margin-bottom: 8dp;
    font-family: yellow12;
    font-size: 12dp;
}

#panels
{
    display: flex;
    flex-direction: row;
}

.panel
{
    display: block;
    flex: 1;
    margin: 4dp;
    padding: 6dp;
    background-color: #182018;
}

.label
{
    display: block;
    height: 10dp;
    margin-bottom: 6dp;
}

/* The main menu's buttons, their words in their pictures: up (and lit, as in 1998), pressed, grayed. */
.button
{
    display: block;
    width: 217dp;
    height: 26dp;
    margin-bottom: 4dp;
    decorator: image(art:mm_xbh01);
}

.button:active
{
    decorator: image(art:mm_xbg01);
}

.button.grayed
{
    decorator: image(art:mm_xbn02);
}

#list
{
    display: block;
    height: 72dp;
    overflow-y: scroll;
}

.row
{
    display: block;
    height: 12dp;
}

.row:hover
{
    background-color: #304030;
}

scrollbarvertical
{
    width: 6dp;
}

scrollbarvertical slidertrack
{
    background-color: #202820;
}

scrollbarvertical sliderbar
{
    background-color: #708070;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc
{
    height: 0;
}

.text
{
    display: block;
    height: 10dp;
    margin-bottom: 4dp;
}

.yellow
{
    font-family: yellow10;
}

/* Narrower than 3:2 (a 4:3 window): the panels stacked. */
@media (max-aspect-ratio: 3/2)
{
    #panels
    {
        flex-direction: column;
    }

    .panel
    {
        flex: 0 0 auto;
    }
}
